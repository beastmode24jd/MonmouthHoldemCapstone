@model ClubMessageViewModel
@{
    ViewData["Title"] = $"{Model.Club.Name} Chatroom";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">

            @* Feedback/Error messages for user *@

            @if (TempData["MessageError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["InviteError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @* Header: name + public/private badge *@
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
                <h1 class="card-title mb-0">
                    <i class="bi bi-people-fill"></i> @Model.Club.Name
                </h1>
                <span class="badge @(Model.Club.IsPublic ? "bg-primary" : "bg-secondary") fs-6">
                    @(Model.Club.IsPublic ? "Public" : "Private")
                </span>
            </div>


        </div>
    </div>
</div>