@model ClubListViewModel
@{
    ViewData["Title"] = "Clubs";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">
            <h1 class="card-title">
                <i class="bi bi-people-fill"></i> Clubs
            </h1>
            <hr />

            @* Filter Controls — CSP-124 *@
            <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                <div class="btn-group" role="group" aria-label="Clubs filter">
                    <button id="filterAll" type="button" class="btn btn-primary active">
                        <i class="bi bi-globe"></i> All Public Clubs
                    </button>
                    <button id="filterMine" type="button" class="btn btn-outline-primary">
                        <i class="bi bi-person-fill"></i> My Clubs
                    </button>
                </div>
                <span id="clubCountLabel" class="text-muted small"></span>
            </div>

            @* Public Clubs empty state — shown when DB has no public Clubs at all *@
            @if (!Model.HasPublicClubs)
            {
                <div id="emptyStateAll" class="text-center py-5">
                    <i class="bi bi-people display-1 text-muted mb-3"></i>
                    <h3 class="text-muted">No Clubs Yet...</h3>
                    <p class="lead text-muted mb-4">
                        Find and join clubs to connect with other wildlife enthusiasts.
                    </p>
                    <button type="button" class="btn btn-primary btn-lg" onclick="showClubModal()">
                        <i class="bi bi-people-fill"></i> Create your own Club
                    </button>
                </div>
            }

            @* My Clubs empty state — shown by JS when filter is "mine" and user has no clubs *@
            <div id="emptyStateMine" class="text-center py-5" style="display:none">
                <i class="bi bi-people display-1 text-muted mb-3"></i>
                <h3 class="text-muted">You haven't joined any Clubs</h3>
                <p class="lead text-muted mb-4">
                    Create a club or join an existing one to get started!
                </p>
            </div>

            @* Club cards grid *@
            @{
                var userClubIds = Model.UserClubs.Select(uc => uc.Id).ToHashSet();
                var privateUserClubs = Model.UserClubs.Where(uc => !uc.IsPublic).ToList();
            }
            @if (Model.HasPublicClubs || Model.HasPersonalClubs)
            {
                <div id="clubsGrid" class="row g-4">
                    @foreach (var club in Model.PublicClubs)
                    {
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 club-card-wrapper"
                             data-user-id="@club.OwnerIdentityId"
                             data-is-public="true"
                             data-is-member="@(userClubIds.Contains(club.Id) ? "true" : "false")">
                            <div class="card h-100 shadow-sm club-card">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@club.Name</h5>
                                    <p class="card-text text-muted small flex-grow-1">@club.Description</p>
                                    <a asp-action="ClubPage" asp-route-id="@club.Id"
                                       class="btn btn-outline-primary btn-sm mt-2 align-self-start">
                                        View Club
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    @foreach (var club in privateUserClubs)
                    {
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 club-card-wrapper"
                             data-user-id="@club.OwnerIdentityId"
                             data-is-public="false"
                             data-is-member="true">
                            <div class="card h-100 shadow-sm club-card">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@club.Name</h5>
                                    <p class="card-text text-muted small flex-grow-1">@club.Description</p>
                                    <a asp-action="ClubPage" asp-route-id="@club.Id"
                                       class="btn btn-outline-primary btn-sm mt-2 align-self-start">
                                        View Club
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="row g2">
                <div class="mt-4 mb-4">
                    <button type="button" class="btn btn-primary btn-lg" onclick="showClubModal()">
                        <i class="bi bi-people-fill"></i> Create your own Club
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

@* New Club input modal (hidden initially) *@
<div class="modal fade" id="newClubModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Create a new Club</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Clubs" asp-action="CreateClub" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="modalClubName" class="form-label">Name</label>
                        <input type="text" id="modalClubName" name="name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <textarea id="descInput" name="description" class="form-control" rows="6" maxlength="250" placeholder="Tell us about your Club..."></textarea>
                        <div class="form-text">Club description should be 250 characters or less.</div>
                        <span id="charCount" class="form-text">0/250</span>
                        <div id="descErrorMsg" class="text-danger fw-bold small mt-1" style="display:none;"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Visibility</label>
                        <div class="btn-group w-100" role="group" aria-label="Club visibility">
                            <input type="radio" class="btn-check" name="isPublic" id="radioPublic" value="true" autocomplete="off" checked />
                            <label class="btn btn-outline-primary" for="radioPublic">
                                <i class="bi bi-globe"></i> Public
                            </label>
                            <input type="radio" class="btn-check" name="isPublic" id="radioPrivate" value="false" autocomplete="off" />
                            <label class="btn btn-outline-secondary" for="radioPrivate">
                                <i class="bi bi-lock-fill"></i> Private
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="confirmAuthBtn">Create Club</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Hidden element carrying the current user's ID for client-side filtering *@
<span id="currentUserId" data-user-id="@Model.CurrentUserId" style="display:none"></span>

@* Club modal + Club filter + sessionStorage persistence *@
<script>
    function showClubModal() {
    // Clear text field from any previous entries
    const nameInput = document.getElementById('modalClubName');
    if (nameInput)
    {
        nameInput.value = '';
    }

    const descriptionInput = document.getElementById('descInput');
    if (descriptionInput)
    {
        descriptionInput.value = '';
    }

    // Reset the character counter display when the modal opens
    const counter = document.getElementById('charCount');
    if (counter) counter.textContent = '0/250';

    // Initialize and show Manage.cshtml Bootstrap Modal
    const modalElement = document.getElementById('newClubModal');
    const modal = new bootstrap.Modal(modalElement);
    modal.show();
    }

    (function () {
        const STORAGE_KEY = 'clubsFilter';
        const currentUserId = document.getElementById('currentUserId')?.dataset.userId ?? '';

        const filterAllBtn = document.getElementById('filterAll');
        const filterMineBtn = document.getElementById('filterMine');
        const emptyStateMine = document.getElementById('emptyStateMine');
        const emptyStateAll = document.getElementById('emptyStateAll');
        const countLabel = document.getElementById('clubCountLabel');

        function applyFilter(filter) {
            sessionStorage.setItem(STORAGE_KEY, filter);

            const cards = document.querySelectorAll('.club-card-wrapper');
            let visibleCount = 0;

            if (filter === 'mine') {
                filterAllBtn.classList.remove('btn-primary', 'active');
                filterAllBtn.classList.add('btn-outline-primary');
                filterMineBtn.classList.remove('btn-outline-primary');
                filterMineBtn.classList.add('btn-primary', 'active');

                cards.forEach(function (card) {
                    if (card.dataset.isMember === 'true') {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (emptyStateAll) emptyStateAll.style.display = 'none';
                if (emptyStateMine) emptyStateMine.style.display = visibleCount === 0 ? '' : 'none';
                if (countLabel) {
                    countLabel.textContent = visibleCount === 0
                        ? ''
                        : visibleCount + ' ' + (visibleCount === 1 ? 'club' : 'clubs');
                }
            } else {
                filterAllBtn.classList.add('btn-primary', 'active');
                filterAllBtn.classList.remove('btn-outline-primary');
                filterMineBtn.classList.add('btn-outline-primary');
                filterMineBtn.classList.remove('btn-primary', 'active');

                cards.forEach(function (card) {
                    if (card.dataset.isPublic === 'true') {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (emptyStateAll) emptyStateAll.style.display = visibleCount === 0 ? '' : 'none';
                if (emptyStateMine) emptyStateMine.style.display = 'none';
                if (countLabel) {
                    countLabel.textContent = visibleCount + ' ' + (visibleCount === 1 ? 'club' : 'clubs');
                }
            }
        }

        if (filterAllBtn) filterAllBtn.addEventListener('click', function () { applyFilter('all'); });
        if (filterMineBtn) filterMineBtn.addEventListener('click', function () { applyFilter('mine'); });

        const saved = sessionStorage.getItem(STORAGE_KEY) || 'all';
        applyFilter(saved);
    })();
</script>
