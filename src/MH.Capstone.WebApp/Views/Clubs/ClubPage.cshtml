@model ClubPageViewModel
@{
    ViewData["Title"] = Model.Club.Name;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">

            @* Header: name + public/private badge *@
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
                <h1 class="card-title mb-0">
                    <i class="bi bi-people-fill"></i> @Model.Club.Name
                </h1>
                <span class="badge @(Model.Club.IsPublic ? "bg-primary" : "bg-secondary") fs-6">
                    @(Model.Club.IsPublic ? "Public" : "Private")
                </span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Club.Description))
            {
                <p class="text-muted mt-2">@Model.Club.Description</p>
            }

            <hr />

            @* Owner and creation date *@
            <p class="mb-1">
                <strong>Owner:</strong> @Model.Club.Owner.UserName
            </p>
            <p class="text-muted small mb-0">
                Created @Model.Club.CreatedAt.ToString("MMMM d, yyyy")
            </p>

            <hr />

            @* Action buttons *@
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Chatroom" asp-route-id="@Model.Club.Id" class="btn btn-primary">
                    <i class="bi bi-chat-fill"></i> Go to Chatroom
                </a>

                @if (Model.IsCurrentUserOwner)
                {
                    <button type="button" class="btn btn-outline-primary"
                            data-bs-toggle="modal" data-bs-target="#inviteMemberModal"
                            id="inviteMemberBtn">
                        <i class="bi bi-person-plus-fill"></i> Invite Member
                    </button>
                }

                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Clubs
                </a>
            </div>

        </div>
    </div>
</div>

@* Invite Member modal — rendered only for the club owner; invite send not yet implemented *@
@if (Model.IsCurrentUserOwner)
{
    <div class="modal fade" id="inviteMemberModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-person-plus-fill"></i> Invite a Member
                    </h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="memberSearchInput" class="form-label">Search by username</label>
                        <input type="text" id="memberSearchInput" class="form-control"
                               placeholder="Enter a username..." />
                    </div>
                    <div id="memberSearchResults"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="sendInviteBtn" disabled>
                        Send Invite
                    </button>
                </div>
            </div>
        </div>
    </div>
}
