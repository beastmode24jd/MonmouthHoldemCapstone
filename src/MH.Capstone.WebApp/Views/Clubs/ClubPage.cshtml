@using MH.Capstone.Domain.DataModels
@inject Microsoft.AspNetCore.Identity.UserManager<MH.Capstone.Domain.DataModels.ApplicationUser> _userManager
@{
    ViewData["Title"] = "My Club";

    var userTimeDisplay = ViewData["ClubCreatedAt"];
    var pageClub = ViewData["NewClub"];
    var clubTitle = ViewData["ClubTitle"];
    var user = await _userManager.GetUserAsync(User);

    @* 
        ViewData["ClubCreatedAt"] = timeDisplay;
        ViewData["newClub"] = newClub;
    *@
}

<div class="container mt-4">
    <div class="banner-img-3" role="img" aria-label="A valley underneath a sunset sky.">
