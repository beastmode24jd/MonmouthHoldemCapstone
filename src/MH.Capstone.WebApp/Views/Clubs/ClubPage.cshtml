@model ClubPageViewModel
@{
    ViewData["Title"] = Model.Club.Name;
}

<div class="container mt-4">
    @if (TempData["InviteSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["InviteSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["InviteError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["InviteError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["LeaveError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["LeaveError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">

            @* Header: name + public/private badge *@
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
                <h1 class="card-title mb-0">
                    <i class="bi bi-people-fill"></i> @Model.Club.Name
                </h1>
                <span class="badge @(Model.Club.IsPublic ? "bg-primary" : "bg-secondary") fs-6">
                    @(Model.Club.IsPublic ? "Public" : "Private")
                </span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Club.Description))
            {
                <p class="text-muted mt-2">@Model.Club.Description</p>
            }

            <hr />

            @* Owner and creation date *@
            <p class="mb-1">
                <strong>Owner:</strong> @Model.Club.Owner.UserName
            </p>
            <p class="text-muted small mb-0">
                Created @Model.Club.CreatedAt.ToString("MMMM d, yyyy")
            </p>

            <hr />

            @* Action buttons *@
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Chatroom" asp-route-id="@Model.Club.Id" class="btn btn-primary">
                    <i class="bi bi-chat-fill"></i> Go to Chatroom
                </a>

                @if (Model.IsCurrentUserMember)
                {
                    <button type="button" class="btn btn-outline-primary"
                            data-bs-toggle="modal" data-bs-target="#inviteMemberModal"
                            id="inviteMemberBtn">
                        <i class="bi bi-person-plus-fill"></i> Invite Member
                    </button>
                }

                @if (Model.IsCurrentUserMember && !Model.IsCurrentUserOwner)
                {
                    <button type="button" class="btn btn-outline-danger"
                            data-bs-toggle="modal" data-bs-target="#leaveClubModal"
                            id="leaveClubBtn">
                        <i class="bi bi-box-arrow-left"></i> Leave Club
                    </button>
                }

                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Clubs
                </a>
            </div>

        </div>
    </div>
</div>

@* Invite Member modal — visible to all accepted members *@
@if (Model.IsCurrentUserMember)
{
    <div class="modal fade" id="inviteMemberModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-person-plus-fill"></i> Invite a Member
                    </h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="sendInviteForm" asp-action="SendInvite" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clubId" value="@Model.Club.Id" />
                    <input type="hidden" name="receiverId" id="selectedReceiverId" value="" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="memberSearchInput" class="form-label">Search by display name</label>
                            <input type="text" id="memberSearchInput" class="form-control"
                                   placeholder="Start typing a name..." autocomplete="off" />
                        </div>
                        <div id="memberSearchResults" class="list-group mb-2"></div>
                        <div id="selectedUserDisplay" class="d-none alert alert-info py-2">
                            Sending invite to: <strong id="selectedUserName"></strong>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="sendInviteBtn" disabled>
                            <i class="bi bi-send-fill"></i> Send Invite
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* Leave Club confirm modal — visible only to non-owner members *@
@if (Model.IsCurrentUserMember && !Model.IsCurrentUserOwner)
{
    <div class="modal fade" id="leaveClubModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill"></i> Leave Club
                    </h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to leave <strong>@Model.Club.Name</strong>?</p>
                    <p class="text-muted small mb-0">You will need to be invited back by a member to rejoin.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="LeaveClub" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="clubId" value="@Model.Club.Id" />
                        <button type="submit" class="btn btn-danger" id="confirmLeaveBtn">
                            <i class="bi bi-box-arrow-left"></i> Yes, Leave Club
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.IsCurrentUserMember)
{
    <script>
        (function () {
            const clubId = '@Model.Club.Id';
            const searchInput = document.getElementById('memberSearchInput');
            const resultsContainer = document.getElementById('memberSearchResults');
            const selectedDisplay = document.getElementById('selectedUserDisplay');
            const selectedUserName = document.getElementById('selectedUserName');
            const selectedReceiverIdInput = document.getElementById('selectedReceiverId');
            const sendBtn = document.getElementById('sendInviteBtn');

            let debounceTimer = null;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const query = searchInput.value.trim();

                if (query.length < 2) {
                    resultsContainer.innerHTML = '';
                    return;
                }

                debounceTimer = setTimeout(function () {
                    fetch(`/Clubs/SearchUsers?clubId=${clubId}&query=${encodeURIComponent(query)}`)
                        .then(r => r.json())
                        .then(function (users) {
                            resultsContainer.innerHTML = '';
                            if (users.length === 0) {
                                resultsContainer.innerHTML = '<div class="list-group-item text-muted">No users found.</div>';
                                return;
                            }
                            users.forEach(function (u) {
                                const btn = document.createElement('button');
                                btn.type = 'button';
                                btn.className = 'list-group-item list-group-item-action';
                                btn.textContent = u.displayName;
                                btn.addEventListener('click', function () {
                                    selectedReceiverIdInput.value = u.id;
                                    selectedUserName.textContent = u.displayName;
                                    selectedDisplay.classList.remove('d-none');
                                    sendBtn.disabled = false;
                                    resultsContainer.innerHTML = '';
                                    searchInput.value = '';
                                });
                                resultsContainer.appendChild(btn);
                            });
                        });
                }, 300);
            });

            // Reset state when modal is closed
            document.getElementById('inviteMemberModal').addEventListener('hidden.bs.modal', function () {
                searchInput.value = '';
                resultsContainer.innerHTML = '';
                selectedDisplay.classList.add('d-none');
                selectedReceiverIdInput.value = '';
                sendBtn.disabled = true;
            });
        })();
    </script>
}
