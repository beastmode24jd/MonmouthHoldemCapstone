@model ClubPageViewModel
@{
    ViewData["Title"] = Model.Club.Name;
}

<div class="container mt-4 mb-3 pb-3">
    <div class="card shadow">
        @* Header: name + public/private badge *@
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1 mainHeader">
            <h1 class="card-title mb-0">
                <i class="bi bi-people-fill fillOrange"></i> @Model.Club.Name
            </h1>
            <span class="badge @(Model.Club.IsPublic ? "orange-flat" : "green-flat") fs-6">
                @(Model.Club.IsPublic ? "Public" : "Private")
            </span>
        </div>
        <div class="card-body overflow-hidden notebook">

            @if (TempData["InviteSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["InviteSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["InviteError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["InviteError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["LeaveError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["LeaveError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Club.Description))
            {
                <p class="text-muted mt-2">@Model.Club.Description</p>
            }

            @* Owner and creation date *@
            <p class="mb-1">
                <strong>Owner:</strong> @Model.Club.Owner.DisplayName
            </p>
            <p class="text fillGreen small mb-0">
                Created @Model.Club.CreatedAt.ToString("MMMM d, yyyy")
            </p>

            <br />

            @* CSP-125: Clubs Feed
               Has recent Sightings cards from the members
               Should update if a member leaves the Club *@
            <p class="mb-1">
                <strong>Activity Feed</strong>
            </p>

            @* CSP-215: render the same shared grid the global gallery uses, so any
               card/view changes apply here automatically instead of drifting. *@
            @if (Model.HasSightings)
            {
                <partial name="_SightingCardGrid" model="Model.Sightings" />
            } else {
                <p class="text-muted medium mb-0">
                No activity in this Club yet. Try uploading a Sighting!
                </p>
            }
            
            @if (Model.ClubMembers.Any())
            {
                <br />
                <div class="bg-white">
                    <p class="mb-2"><strong>Club Highlights</strong></p>
                    <div class="d-flex flex-wrap gap-4">
                        @if (Model.TopMembersByPoints.Any())
                        {
                            <div>
                                <p class="text-p-size mb-1">
                                    <i class="bi bi-trophy-fill fillOrange me-1"></i> Top Members
                                </p>
                                <ol class="mb-0 ps-3">
                                    @foreach (var top in Model.TopMembersByPoints)
                                    {
                                        <li class="medium">
                                            @top.Member?.DisplayName
                                            <span class="badge bg-points ms-1">@(top.Member?.Points ?? 0) pts</span>
                                        </li>
                                    }
                                </ol>
                            </div>
                        }

                        @if (Model.NewestMember != null)
                        {
                            <div>
                                <p class="text-muted mb-1">
                                    <i class="bi bi-person-plus-fill fillGreen me-1"></i> Newest Member
                                </p>
                                <p class="medium mb-0">
                                    @Model.NewestMember.Member?.DisplayName
                                    <span class="text-muted">— joined @Model.NewestMember.JoinedAt.ToString("MMM d, yyyy")</span>
                                </p>
                            </div>
                        }

                        <div>
                            <p class="text-muted mb-1">
                                <i class="bi bi-camera-fill fillGreen me-1"></i> Total Sightings
                            </p>
                            <p class="medium mb-0">@Model.TotalSightingsCount sighting@(Model.TotalSightingsCount == 1 ? "" : "s")</p>
                        </div>
                    </div>
                </div>
            }

            <br />

            @* Action buttons *@
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Chatroom" asp-route-id="@Model.Club.Id" class="btn bg-orange">
                    <i class="bi bi-chat-fill"></i> Go to Chatroom
                </a>

                @if (Model.IsCurrentUserMember)
                {
                    <button type="button" class="btn bg-midGreen"
                            data-bs-toggle="modal" data-bs-target="#inviteMemberModal"
                            id="inviteMemberBtn">
                        <i class="bi bi-person-plus-fill"></i> Invite Member
                    </button>
                }

                @if (Model.IsCurrentUserMember && !Model.IsCurrentUserOwner)
                {
                    <button type="button" class="btn bg-orange"
                            data-bs-toggle="modal" data-bs-target="#leaveClubModal"
                            id="leaveClubBtn">
                        <i class="bi bi-box-arrow-left"></i> Leave Club
                    </button>
                }

                <button type="button" class="btn bg-midGreen-outline"
                        data-bs-toggle="modal" data-bs-target="#membersModal"
                        id="viewMembersBtn">
                    <i class="bi bi-people-fill"></i> Members (@Model.ClubMembers.Count)
                </button>

                <a asp-action="Index" class="btn bg-midGreen-outline">
                    <i class="bi bi-arrow-left"></i> Back to Clubs
                </a>
            </div>

        </div>
    </div>
</div>

@* Invite Member modal — visible to all accepted members *@
@if (Model.IsCurrentUserMember)
{
    <div class="modal fade" id="inviteMemberModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header subheader">
                    <h5 class="modal-title text-white bold">
                        <i class="bi bi-person-plus-fill"></i> Invite a Member
                    </h5>
                </div>
                <form id="sendInviteForm" asp-action="SendInvite" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clubId" value="@Model.Club.Id" />
                    <input type="hidden" name="receiverId" id="selectedReceiverId" value="" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="memberSearchInput" class="form-label text">Search by display name</label>
                            <input type="text" id="memberSearchInput" class="form-control"
                                   placeholder="Start typing a name..." autocomplete="off" />
                        </div>
                        <div id="memberSearchResults" class="list-group mb-2"></div>
                        <div id="selectedUserDisplay" class="d-none alert alert-success py-2">
                            Sending invite to: <strong id="selectedUserName"></strong>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn bg-midGreen-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn bg-orange" id="sendInviteBtn" disabled>
                            <i class="bi bi-send-fill"></i> Send Invite
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* Leave Club confirm modal — visible only to non-owner members *@
@if (Model.IsCurrentUserMember && !Model.IsCurrentUserOwner)
{
    <div class="modal fade" id="leaveClubModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header subheader orange-flat">
                    <h5 class="modal-title text-white bold">
                        <i class="bi bi-exclamation-triangle-fill text-white"></i> Leave Club
                    </h5>
                </div>
                <div class="modal-body overflow-hidden border-0 text-start">
                    <p>Are you sure you want to leave <strong>@Model.Club.Name</strong>?</p>
                    <p class="text-small mb-0">You will need to be invited back by a member to rejoin.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn bg-midGreen-outline" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="LeaveClub" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="clubId" value="@Model.Club.Id" />
                        <button type="submit" class="btn bg-orange" id="confirmLeaveBtn">
                            <i class="bi bi-box-arrow-left"></i> Yes, Leave Club
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@* Members list modal *@
<div class="modal fade" id="membersModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header subheader">
                <h5 class="modal-title text-white bold">
                    <i class="bi bi-people-fill text-light"></i> Members
                </h5>
            </div>
            <div class="modal-body p-0">
                @if (!Model.ClubMembers.Any())
                {
                    <p class="text-muted text-center py-4 mb-0">No members yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var m in Model.ClubMembers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-person-fill me-1 fillGreen"></i>
                                    @m.Member?.DisplayName
                                    @if (m.MemberId == Model.Club.OwnerId)
                                    {
                                        <span class="badge bg-orange ms-1">Owner</span>
                                    }
                                </div>
                                <span class="text-muted small">Joined @m.JoinedAt.ToString("MMM d, yyyy")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn bg-midGreen-outline" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@if (Model.IsCurrentUserMember)
{
    <script>
        (function () {
            const clubId = '@Model.Club.Id';
            const searchInput = document.getElementById('memberSearchInput');
            const resultsContainer = document.getElementById('memberSearchResults');
            const selectedDisplay = document.getElementById('selectedUserDisplay');
            const selectedUserName = document.getElementById('selectedUserName');
            const selectedReceiverIdInput = document.getElementById('selectedReceiverId');
            const sendBtn = document.getElementById('sendInviteBtn');

            let debounceTimer = null;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const query = searchInput.value.trim();

                if (query.length < 2) {
                    resultsContainer.innerHTML = '';
                    return;
                }

                debounceTimer = setTimeout(function () {
                    fetch(`/Clubs/SearchUsers?clubId=${clubId}&query=${encodeURIComponent(query)}`)
                        .then(r => r.json())
                        .then(function (users) {
                            resultsContainer.innerHTML = '';
                            if (users.length === 0) {
                                resultsContainer.innerHTML = '<div class="list-group-item text-muted">No users found.</div>';
                                return;
                            }
                            users.forEach(function (u) {
                                const btn = document.createElement('button');
                                btn.type = 'button';
                                btn.className = 'list-group-item list-group-item-action';
                                btn.textContent = u.displayName;
                                btn.addEventListener('click', function () {
                                    selectedReceiverIdInput.value = u.id;
                                    selectedUserName.textContent = u.displayName;
                                    selectedDisplay.classList.remove('d-none');
                                    sendBtn.disabled = false;
                                    resultsContainer.innerHTML = '';
                                    searchInput.value = '';
                                });
                                resultsContainer.appendChild(btn);
                            });
                        });
                }, 300);
            });

            // Reset state when modal is closed
            document.getElementById('inviteMemberModal').addEventListener('hidden.bs.modal', function () {
                searchInput.value = '';
                resultsContainer.innerHTML = '';
                selectedDisplay.classList.add('d-none');
                selectedReceiverIdInput.value = '';
                sendBtn.disabled = true;
            });
        })();
    </script>
}
