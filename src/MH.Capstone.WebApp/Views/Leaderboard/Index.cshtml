@model MH.Capstone.WebApp.Models.LeaderboardViewModel
@{
    ViewData["Title"] = "Leaderboard";
}

<style>
    .table-muted-green th {
        background-color: #9b7544 !important;
        color: #ffffff !important;
        border-bottom: 1px solid #52664c !important;
    }

    /* Light warm-tone background for the current user's table data cells */
    .user-highlight-row td {
        background-color: rgba(241, 164, 62, 0.366) !important;
    }
</style>

<div class="container mt-4 mb-3 pb-3">
    <div class="card shadow">
        <h1 class="card-title mainHeader">
                <i class="bi bi-trophy-fill fillOrange"></i> Leaderboard
        </h1>
        <div class="card-body">

            @* "Jump to My Rank" button — only shown when a user is logged in and has a rank *@
            @if (Model.UserRank > 0)
            {
                <div class="mb-3">
                    <a asp-action="Index"
                       asp-route-page="@Model.UserPage"
                       class="btn bg-midGreen">
                        <i class="bi bi-person-fill"></i> Jump to My Rank (#@Model.UserRank)
                    </a>
                </div>
            }

            @* Leaderboard table — CSP-176: wrapped in `.table-responsive` so long
               display names fall back to a *table-internal* horizontal scroll on
               narrow viewports instead of pushing the whole page wider than the
               screen. Desktop renders identically (the wrapper has no visual effect
               when the table fits). *@
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-muted-green">
                        <tr>
                            <th scope="col">Rank</th>
                            <th scope="col">Player</th>
                            <th scope="col">Points</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            // Calculate the rank number for the first entry on this page.
                            // Page 1 starts at rank 1, page 2 starts at rank 31, etc.
                            int rankStart = (Model.CurrentPage - 1) * 30 + 1;
                        }
                        @for (int i = 0; i < Model.Users.Count; i++)
                        {
                            var entry = Model.Users[i];
                            // Highlight the logged-in user's row with a distinct background color.
                            var rowClass = entry.Id == Model.CurrentUserId ? "user-highlight-row fw-bold" : "";

                            <tr class="@rowClass" id="user-@entry.Id">
                                <td>@(rankStart + i)</td>
                                <td>@entry.DisplayName</td>
                                <td>@entry.Points</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Prev / Next pagination arrows — only shown when there is more than one page.
               CSP-176: hide the "Previous"/"Next" labels on xs viewports (icons + page
               indicator are still visible), and shorten the indicator to "X / Y" on
               mobile. Desktop layout is unchanged. *@
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Leaderboard pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               aria-label="Previous">
                                <i class="bi bi-arrow-left"></i><span class="d-none d-sm-inline"> Previous</span>
                            </a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">
                                <span class="d-none d-sm-inline">Page @Model.CurrentPage of @Model.TotalPages</span>
                                <span class="d-inline d-sm-none">@Model.CurrentPage / @Model.TotalPages</span>
                            </span>
                        </li>
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               aria-label="Next">
                                <span class="d-none d-sm-inline">Next </span><i class="bi bi-arrow-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }

        </div>
    </div>
</div>

@* CSP-180: SignalR client is loaded in _Layout.cshtml; this just hooks
   the leaderboard-page-specific listeners onto the site-wide connection. *@
@section Scripts {
    <script src="~/js/leaderboard-live.js" asp-append-version="true"></script>
}
