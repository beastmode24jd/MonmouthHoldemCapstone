@model MH.Capstone.WebApp.Models.LeaderboardViewModel
@{
    ViewData["Title"] = "Leaderboard";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">
            <h1 class="card-title">
                <i class="bi bi-trophy-fill text-warning"></i> Leaderboard
            </h1>
            <hr />

            @* "Jump to My Rank" button — only shown when a user is logged in and has a rank *@
            @if (Model.UserRank > 0)
            {
                <div class="mb-3">
                    <a asp-action="Index"
                       asp-route-page="@Model.UserPage"
                       class="btn btn-primary">
                        <i class="bi bi-person-fill"></i> Jump to My Rank (#@Model.UserRank)
                    </a>
                </div>
            }

            @* Leaderboard table *@
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Player</th>
                        <th scope="col">Points</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        // Calculate the rank number for the first entry on this page.
                        // Page 1 starts at rank 1, page 2 starts at rank 31, etc.
                        int rankStart = (Model.CurrentPage - 1) * 30 + 1;
                    }
                    @for (int i = 0; i < Model.Users.Count; i++)
                    {
                        var entry = Model.Users[i];
                        // Highlight the logged-in user's row with a distinct background color.
                        var rowClass = entry.Id == Model.CurrentUserId ? "table-primary fw-bold" : "";

                        <tr class="@rowClass" id="user-@entry.Id">
                            <td>@(rankStart + i)</td>
                            <td>@entry.DisplayName</td>
                            <td>@entry.Points</td>
                        </tr>
                    }
                </tbody>
            </table>

            @* Prev / Next pagination arrows — only shown when there is more than one page *@
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Leaderboard pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)">
                                <i class="bi bi-arrow-left"></i> Previous
                            </a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
                        </li>
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)">
                                Next <i class="bi bi-arrow-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }

        </div>
    </div>
</div>

@* CSP-180: SignalR client + live leaderboard wiring *@
@section Scripts {
    <script src="https://unpkg.com/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/leaderboard-live.js" asp-append-version="true"></script>
}
