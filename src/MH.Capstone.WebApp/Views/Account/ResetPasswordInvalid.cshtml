@{
    ViewData["Title"] = "Invalid Reset Link";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow">
            <div class="card-body text-center">
                <h2 class="card-title mb-4">Reset Link Invalid or Expired</h2>
                <div class="alert alert-danger" role="alert" id="invalidResetLinkMessage">
                    This password reset link is invalid or has expired. Reset links can only be used once
                    and expire shortly after being issued.
                </div>
                <a asp-action="ForgotPassword" asp-controller="Account"
                   class="btn btn-primary" id="requestNewResetLinkBtn">
                    Request a New Reset Link
                </a>
                <div class="mt-3">
                    <a asp-action="Login" asp-controller="Account"
                       class="link-primary text-decoration-underline">
                        Back to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
