@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">Forgot Password</h2>

                @if (Model.EmailSent)
                {
                    <div class="alert alert-success" role="alert" id="resetEmailSentMessage">
                        <strong>Check your email.</strong><br />
                        If an account with that address exists, we have sent a password reset link.
                        The link expires shortly, so check your inbox now.
                    </div>
                    <div class="text-center mt-3">
                        <a asp-action="Login" asp-controller="Account" class="btn btn-outline-primary">
                            Back to Login
                        </a>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center mb-4">
                        Enter your registered email address and we will send you a link to reset your password.
                    </p>
                    <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email address</label>
                            <input asp-for="Email" class="form-control" type="email"
                                   id="forgotPasswordEmail" placeholder="Enter your email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary" id="sendResetEmailBtn">
                                Send Reset Link
                            </button>
                        </div>
                        <div class="text-center mt-3">
                            <a asp-action="Login" asp-controller="Account"
                               class="link-primary text-decoration-underline">
                                Back to Login
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
