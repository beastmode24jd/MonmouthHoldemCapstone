@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">Forgot Password</h2>

                <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Identifier" class="form-label">Email</label>
                        <input asp-for="Identifier" class="form-control" type="email" placeholder="Enter your email" />
                        <span asp-validation-for="Identifier" class="text-danger"></span>
                    </div>

                    @if (Model.ShowPasswordResetFields)
                    {
                        <hr />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">New Password</label>
                            <input asp-for="NewPassword" class="form-control" type="password" placeholder="New password" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password</label>
                            <input asp-for="ConfirmNewPassword" class="form-control" type="password" placeholder="Confirm new password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            @(Model.ShowPasswordResetFields ? "Save" : "Search")
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-action="Login" asp-controller="Account" class="link-primary text-decoration-underline">
                            Back to Login
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
