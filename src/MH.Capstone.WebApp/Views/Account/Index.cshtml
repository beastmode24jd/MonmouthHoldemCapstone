@model AccountViewModel
@{
    ViewData["Title"] = "Account Details";
    // If the user not the authenticated user, show the user's name, email or id in the title, depending on what is set.
    // Otherwise, show a title indicated that a user is viewing their own account.
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">
            <h1 class="card-title">@(Model.IsAuthenticatedUser ? "Your Profile" : $"{Model.DisplayName}'s Profile")</h1>
            <div class="mt-3">
                <div class="row">
                    <div class="col-12 col-md-2 d-flex justify-content-center align-items-center">
                        <img class="dashboardProfile img-fluid" 
                        src="@Model.ProfileImageUrl" 
                        aria-label="@Model.DisplayName Profile Image"
                        style="width: 80px; height: 80px; object-fit: cover;" />
                    </div>
                    <div class="col-12 col-md-10">
                        <ul class="list-group list-group-flush">
                            @if (!string.IsNullOrEmpty(Model.DisplayName) && Model.DisplayName != "UNSET")
                            {
                                <li class="list-group-item">
                                    <strong>Username:</strong> @Model.DisplayName
                                </li>
                            }
                            <li class="list-group-item">
                                <strong>Status:</strong>
                                @if (Model.IsDeactivated)
                                {
                                    <span class="badge bg-error">Deactivated</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </li>
                            <li class="list-group-item">
                                <strong>Total points:</strong> @* @Model.WriteThisIntoAccountViewModel_Later *@
                            </li>
                            @* Add recent Sightings, Badges, and/or Clubs to their page? *@
                        </ul>

                        @* CSP-187: Follow + Block toggles, only shown when viewing another user *@
                        @if (!Model.IsAuthenticatedUser)
                        {
                            <div id="profileSocialActions" class="mt-3 d-flex flex-wrap gap-2">
                                @if (Model.IsFollowedByCurrentUser)
                                {
                                    <form asp-controller="User" asp-action="Unfollow" asp-route-id="@Model.Id" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button id="unfollowButton" type="submit" class="btn btn-outline-primary">
                                            <i class="bi bi-person-dash"></i> Unfollow
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="User" asp-action="Follow" asp-route-id="@Model.Id" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button id="followButton" type="submit" class="btn btn-primary">
                                            <i class="bi bi-person-plus"></i> Follow
                                        </button>
                                    </form>
                                }

                                @if (Model.IsBlockedByCurrentUser)
                                {
                                    <form asp-controller="User" asp-action="Unblock" asp-route-id="@Model.Id" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button id="unblockButton" type="submit" class="btn btn-outline-danger">
                                            <i class="bi bi-shield-check"></i> Unblock
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="User" asp-action="Block" asp-route-id="@Model.Id" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button id="blockButton" type="submit" class="btn btn-outline-danger">
                                            <i class="bi bi-shield-x"></i> Block
                                        </button>
                                    </form>
                                }
                            </div>

                            @if (TempData["FollowError"] is string followErr)
                            {
                                <div id="profileFollowError" class="alert alert-warning mt-2">@followErr</div>
                            }
                            @if (TempData["BlockError"] is string blockErr)
                            {
                                <div id="profileBlockError" class="alert alert-warning mt-2">@blockErr</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>