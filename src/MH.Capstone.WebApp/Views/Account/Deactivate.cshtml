@model DeactivateAccountViewModel
@{
    ViewData["Title"] = "Deactivate Account";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Deactivate Account</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <strong>Warning:</strong> Deactivating your account will:
                    <ul class="mb-0 mt-2">
                        <li>Prevent you from logging in</li>
                        <li>Hide your display name on past sightings</li>
                        <li>This action cannot be undone</li>
                    </ul>
                </div>

                <form asp-action="Deactivate" method="post">
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Enter your password to confirm</label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger">Deactivate My Account</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}