@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">Reset Password</h2>
                <p class="text-muted text-center mb-4">Enter and confirm your new password below.</p>
                <form asp-action="ResetPassword" asp-controller="Account" method="post">
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" id="resetPasswordError"></div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">New Password</label>
                        <div class="input-group">
                            <input asp-for="NewPassword" class="form-control" type="password"
                                   id="newPasswordField" placeholder="New password" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleNewPassword"
                                    aria-label="Toggle new password visibility">
                                <i class="bi bi-eye" id="toggleNewPasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                        <div class="form-text">
                            At least 8 characters with uppercase, lowercase, number, and symbol.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password</label>
                        <div class="input-group">
                            <input asp-for="ConfirmNewPassword" class="form-control" type="password"
                                   id="confirmPasswordField" placeholder="Confirm new password" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword"
                                    aria-label="Toggle confirm password visibility">
                                <i class="bi bi-eye" id="toggleConfirmPasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary" id="resetPasswordBtn">
                            Reset Password
                        </button>
                    </div>
                    <div class="text-center mt-3">
                        <a asp-action="ForgotPassword" asp-controller="Account"
                           class="link-primary text-decoration-underline">
                            Request a new reset link
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleNewPassword').addEventListener('click', function () {
            const f = document.getElementById('newPasswordField');
            const i = document.getElementById('toggleNewPasswordIcon');
            f.type = f.type === 'password' ? 'text' : 'password';
            i.classList.toggle('bi-eye');
            i.classList.toggle('bi-eye-slash');
        });
        document.getElementById('toggleConfirmPassword').addEventListener('click', function () {
            const f = document.getElementById('confirmPasswordField');
            const i = document.getElementById('toggleConfirmPasswordIcon');
            f.type = f.type === 'password' ? 'text' : 'password';
            i.classList.toggle('bi-eye');
            i.classList.toggle('bi-eye-slash');
        });
    </script>
}
