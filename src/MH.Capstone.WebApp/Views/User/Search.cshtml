@{
    ViewData["Title"] = "Find Users";
}

<style>
    /* Custom orange border class */
    .border-orange {
        border-color: #8b4312 !important; /* Replace with your specific brand orange hex if different */
    }

    /* Make the focus ring orange when the user clicks the search bar */
    #userSearchInput:focus {
        border-color: #8b4312 !important;
        box-shadow: 0 0 0 0.25rem rgba(241, 141, 54, 0.25) !important;
    }
</style>

<div class="container mt-4 mb-3 pb-3">
    <div class="card shadow">
        <h2 class="card-title subheader"><i class="bi bi-person-search"></i> Find Users</h2>
        <div class="card-body">
            <div class="row mt-3">
                <div class="col-md-6">
                    <div class="input-group" title="User search bar">
                        <span class="input-group-text bg-orange border-orange">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                            id="userSearchInput"
                            class="form-control bg-light border-orange"
                            placeholder="Search by display name..."
                            autocomplete="off"
                            aria-label="User search bar" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card shadow mt-3" id="resultsCard" style="display:none!important">
        <div class="card-body">
            <div id="searchResultsContainer" class="mt-2"></div>

            <div class="d-flex align-items-center gap-3 mt-3" id="pagingControls" style="display:none!important">
                <button id="prevBtn" class="btn bg-midGreen btn-sm" disabled aria-label="Previous page">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <span id="pagingInfo" class="text-muted small">Page 1 of 1 | Showing 0 of 0 Results</span>
                <button id="nextBtn" class="btn bg-midGreen btn-sm" disabled aria-label="Next page">
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const searchInput = document.getElementById('userSearchInput');
    const resultsContainer = document.getElementById('searchResultsContainer');
    const pagingControls = document.getElementById('pagingControls');
    const pagingInfo = document.getElementById('pagingInfo');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    let currentPage = 1;
    let currentQuery = '';
    let debounceTimer;

    function escapeHtml(str) {
        return str
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function buildPagingText(totalCount, page, totalPages, start, end) {
        if (totalCount === 0) {
            return 'Page 1 of 1 | Showing 0 Results';
        }
        if (totalCount === 1) {
            return 'Page 1 of 1 | Showing 1 Result';
        }
        return `Page ${page} of ${totalPages} | Showing ${start}-${end} of ${totalCount} Results`;
    }

    function renderResults(data) {
        const { results, totalCount, page, pageSize, totalPages } = data;

        pagingControls.style.removeProperty('display');
        resultsCard.style.removeProperty('display');

        if (totalCount === 0) {
            resultsContainer.innerHTML = '<p id="noUsersFoundMessage" class="text-muted mt-2">No users were found.</p>';
            pagingInfo.textContent = 'Page 1 of 1 | Showing 0 Results';
            prevBtn.disabled = true;
            nextBtn.disabled = true;
            return;
        }

        const start = (page - 1) * pageSize + 1;
        const end = Math.min(page * pageSize, totalCount);
        const canPage = totalPages > 1;

        resultsContainer.innerHTML = `
            <div class="list-group" id="searchResultsList">
                ${results.map(user => `
                    <a href="/account/${escapeHtml(user.id)}"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3 bg-light border-orange user-result-item">
                        <img src="/user/${escapeHtml(user.id)}/profile-image"
                             alt="${escapeHtml(user.displayName)}"
                             class="rounded-circle user-search-avatar"
                             width="40" height="40"
                             onerror="this.src='/imgs/profileDefault.jpg'" />
                        <span class="user-result-username">${escapeHtml(user.displayName)}</span>
                    </a>
                `).join('')}
            </div>`;

        pagingInfo.textContent = buildPagingText(totalCount, page, totalPages, start, end);
        prevBtn.disabled = !canPage || page <= 1;
        nextBtn.disabled = !canPage || page >= totalPages;
    }

    function renderEmpty() {
        resultsContainer.innerHTML = '';
        pagingControls.style.setProperty('display', 'none', 'important');
        resultsCard.style.setProperty('display', 'none', 'important');
    }

    async function performSearch(query, page) {
        if (!query.trim()) {
            renderEmpty();
            return;
        }

        try {
            const response = await fetch(
                `/user/search/results?query=${encodeURIComponent(query)}&page=${page}`,
                { headers: { 'Accept': 'application/json' } }
            );
            if (!response.ok) return;
            const data = await response.json();
            renderResults(data);
        } catch (err) {
            console.error('User search failed:', err);
        }
    }

    searchInput.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        const query = this.value;
        debounceTimer = setTimeout(() => {
            currentQuery = query;
            currentPage = 1;
            performSearch(currentQuery, currentPage);
        }, 300);
    });

    prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
            currentPage--;
            performSearch(currentQuery, currentPage);
        }
    });

    nextBtn.addEventListener('click', () => {
        currentPage++;
        performSearch(currentQuery, currentPage);
    });
</script>
}
