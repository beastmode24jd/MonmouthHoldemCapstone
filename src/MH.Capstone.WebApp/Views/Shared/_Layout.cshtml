@inject Microsoft.AspNetCore.Identity.UserManager<MH.Capstone.Domain.DataModels.ApplicationUser> _userManager
@using static MH.Capstone.WebApp.VersionHelper
@{
    // Get the current user to access their profile image URL in the layout.
    // This is done here instead of in the controller to ensure it's available for all views that use this layout
    // without needing to set it in each controller action (DRY).
    var user = await _userManager.GetUserAsync(User);
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wildlife AID App</title>
    <script type="importmap"></script>
    <script type="text/javascript">
        async function notificationAlertRefresh() {
            const notifPendingBadge = document.getElementById("pendingNotifBadge");
            const notifPendingBadgeNum = document.getElementById("pendingNotifBadgeNum");
            const notifMenuItem = document.getElementById("notificationsMenuItem");

            const res = await fetch('/notifications/pending-count', {
                method: 'GET',
                headers: { 'Accept': 'application/json' }
            });

            if (!res.ok) {
                console.error('Failed to fetch pending notifications count', res.status);
                return;
            }

            // parse server response (int)
            const pendingCount = await res.json();

            if (pendingCount > 0) {
                notifPendingBadgeNum.textContent = pendingCount;
                notifMenuItem.classList.add("text-danger");
                notifMenuItem.classList.remove("text-light");
                notifPendingBadge.classList.remove("d-none");
            } else {
                notifMenuItem.classList.add("text-light");
                notifMenuItem.classList.remove("text-danger");
                notifPendingBadge.classList.add("d-none");
                notifPendingBadgeNum.textContent = "";
            }
        }

        document.addEventListener('DOMContentLoaded', notificationAlertRefresh);
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MH.Capstone.WebApp.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-0">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img class="logo" role="img" alt="Wildlife AID Logo" aria-label="Wildlife AID Logo"
                         src="~/imgs/site-logo.png" />
                    Wildlife AID
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"                   aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle"></i> About Us
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Leaderboard" asp-action="Index">
                                <i class="bi bi-trophy-fill"></i> Leaderboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Species" asp-action="Search">
                                <i class="bi bi-search"></i> Search for Animals
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* Sprint 5, CSP-54 *@
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="User" asp-action="Search">
                                    <i class="bi bi-person-search"></i> Find Users
                                </a>
                            </li>
                            @* CSP-187: activity feed of followed users' sightings *@
                            <li class="nav-item">
                                <a id="feedNavLink" class="nav-link text-light" asp-controller="Feed" asp-action="Index">
                                    <i class="bi bi-rss-fill"></i> Feed
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" id="sightingsDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                    Sightings
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="sightingsDropdown">
                                    <li>
                                        <a class="dropdown-item text-light" asp-action="Gallery" asp-controller="Sighting">
                                            <i class="bi bi-images"></i> Gallery
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-light" asp-action="Index" asp-controller="Map">
                                            <i class="bi bi-map"></i> Map
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-light" asp-action="Upload" asp-controller="Sighting">
                                            <i class="bi bi-camera"></i> Upload
                                        </a>
                                    </li>
                                    @* CSP-142: Anidex personal collection *@
                                    <li>
                                        <a id="anidexNavLink" class="dropdown-item text-light" asp-action="Index" asp-controller="Anidex">
                                            <i class="bi bi-collection"></i> My Anidex
                                        </a>
                                    </li>
                                    @* CSP-177: Offline queue *@
                                    <li>
                                        <a id="offlineQueueNavLink" class="dropdown-item text-light" asp-action="OfflineQueue" asp-controller="Sighting">
                                            <i class="bi bi-cloud-slash"></i> Offline Queue
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Clubs" asp-action="Index">
                                    <i class="bi bi-people-fill"></i> Clubs
                                </a>
                            </li>
                        }
                    </ul>
                    <!-- Allows for everything after this empty ul to be right-aligned -->
                    <ul class="navbar-nav flex-grow-1"></ul>
                    <ul class="navbar-nav reload-on-notif-change">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* CSP-177: user ID used by offline-queue.js to scope the IndexedDB store *@
                            <span id="currentUserId" class="d-none">@user?.Id</span>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span id="userDropdownNavDisplay">
                                        <img src="@user.GetProfileImageUrl()"
                                             alt="Profile Image"
                                             class="navProfile"
                                             id="navProfile"
                                             role="img"/>
                                        <span id="navDisplayNameText">@(user?.DisplayName != "UNSET" ? user?.DisplayName : User.Identity.Name)</span>
                                        <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-danger d-none"
                                            id="pendingNotifBadge">
                                            <span id="pendingNotifBadgeNum"></span>
                                            <span class="visually-hidden">unread messages</span>
                                        </span>
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end pt-1 pb-1" aria-labelledby="userDropdown">
                                    <li class="menuItem drop">
                                        <a class="nav-link text-light dropdown-item" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-speedometer2"></i> Dashboard
                                        </a>
                                    </li>
                                    <li class="menuItem">
                                        <a class="nav-link dropdown-item text-light" id="notificationsMenuItem" asp-controller="Dashboard" asp-action="Notifications">
                                            <i class="bi bi-bell"></i> Notifications
                                        </a>
                                    </li>
                                    <li class="menuItem">
                                        <a class="nav-link dropdown-item text-light" asp-controller="Dashboard" asp-action="Settings">
                                            <i class="bi bi-gear"></i> Account Settings
                                        </a>
                                    </li>
                                    @* Conditional link for Admins *@
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li class="menuItem"><hr class="dropdown-divider"></li>
                                        <li class="nav-item">
                                            <a class="nav-link text-light dropdown-item" asp-controller="Admin" asp-action="Manage">
                                                <i class="bi bi-gear-wide-connected"></i> Manage Accounts
                                            </a>
                                        </li>
                                    }
                                    <li class="menuItem"><hr class="dropdown-divider"></li>
                                    <li class="menuItem">
                                        <form id="logoutForm" class="d-none" asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                        </form>
                                        <a class="dropdown-item"
                                               href="javascript:document.getElementById('logoutForm').submit();">
                                            <i class="bi bi-box-arrow-right"></i> Log out
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-light">
        <div class="container-fluid ps-4">
            <p class="footerText d-inline">
                Wildlife AID &copy; - @DateTime.Now.Year |
                Version: @GetAppVersion()
            </p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/offline-queue.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Report this page button (bottom-right corner, all pages) -->
        <div style="position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 1040;">
            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#reportModal">
                <i class="bi bi-flag"></i> Report this page
            </button>
        </div>

        <!-- Report Modal -->
        <div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="reportModalLabel"><i class="bi bi-flag"></i> Report this page</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="reportForm" asp-controller="Report" asp-action="Submit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ReportedPageUrl" value="@Context.Request.Path" />
                        <div class="modal-body">
                            <div id="reportMessage" class="d-none" role="alert"></div>
                            <div class="mb-3">
                                <label for="reportReason" class="form-label">Reason <span class="text-danger">*</span></label>
                                <select name="Reason" id="reportReason" class="form-select" required>
                                    <option value="" disabled selected>Select a reason...</option>
                                    <option value="Inappropriate content">Inappropriate content</option>
                                    <option value="Inaccurate information">Inaccurate information</option>
                                    <option value="Spam">Spam</option>
                                    <option value="Harassment">Harassment</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="reportDescription" class="form-label">Additional details (optional)</label>
                                <textarea name="Description" id="reportDescription" class="form-control" rows="3" maxlength="1000" placeholder="Describe the issue..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button id="reportSubmitBtn" type="submit" class="btn btn-danger">Submit Report</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('reportForm').addEventListener('submit', async function (e) {
                e.preventDefault();

                const form = e.target;
                const submitBtn = document.getElementById('reportSubmitBtn');
                const msgDiv = document.getElementById('reportMessage');

                submitBtn.disabled = true;
                submitBtn.textContent = 'Submitting...';
                msgDiv.className = 'd-none';
                msgDiv.textContent = '';

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form)
                    });

                    const data = await response.json();

                    if (response.ok) {
                        msgDiv.className = 'alert alert-success';
                        msgDiv.textContent = data.message;
                        form.reset();
                        setTimeout(() => {
                            bootstrap.Modal.getInstance(document.getElementById('reportModal')).hide();
                        }, 2000);
                    } else {
                        msgDiv.className = 'alert alert-danger';
                        msgDiv.textContent = data.message || 'An error occurred. Please try again.';
                    }
                } catch {
                    msgDiv.className = 'alert alert-danger';
                    msgDiv.textContent = 'Report submission failed. Please wait until your previous report is resolved.';
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit Report';
                }
            });

            document.getElementById('reportModal').addEventListener('hidden.bs.modal', function () {
                const msgDiv = document.getElementById('reportMessage');
                msgDiv.className = 'd-none';
                msgDiv.textContent = '';
            });
        </script>

        <!-- AI Companion button (bottom-left corner, all pages) -->
        <div style="position: fixed; bottom: 1.5rem; left: 1.5rem; z-index: 1040;">
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#aiCompanionModal">
                <i class="bi bi-chat-dots"></i> Ask the AI Companion
            </button>
        </div>

        <!-- AI Companion Modal -->
        <div class="modal fade" id="aiCompanionModal" tabindex="-1" aria-labelledby="aiCompanionModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="aiCompanionModalLabel"><i class="bi bi-chat-dots"></i> AI Wildlife Companion</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="aiCompanionMessages" style="max-height: 300px; overflow-y: auto; margin-bottom: 1rem;">
                            <p class="text-muted"><em>Ask me anything about wildlife, animal behavior, or outdoor safety!</em></p>
                        </div>
                        <form id="aiCompanionForm" asp-controller="AICompanion" asp-action="Ask" method="post">
                            @Html.AntiForgeryToken()
                            <div class="input-group">
                                <input type="text" name="question" id="aiCompanionQuestion" class="form-control"
                                       placeholder="Type your question..." required maxlength="500" autocomplete="off" />
                                <button id="aiCompanionSubmitBtn" type="submit" class="btn btn-primary">
                                    <i class="bi bi-send"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('aiCompanionForm').addEventListener('submit', async function (e) {
                e.preventDefault();

                const form = e.target;
                const input = document.getElementById('aiCompanionQuestion');
                const submitBtn = document.getElementById('aiCompanionSubmitBtn');
                const messagesDiv = document.getElementById('aiCompanionMessages');
                const question = input.value.trim();

                if (!question) return;

                // Capture form data BEFORE clearing the input so the question is included.
                const formData = new FormData(form);

                // Show user message
                const userBubble = document.createElement('div');
                userBubble.className = 'mb-2 text-end';
                userBubble.innerHTML = '<span class="badge bg-primary text-wrap text-start p-2">' + question.replace(/</g, '&lt;') + '</span>';
                messagesDiv.appendChild(userBubble);

                input.value = '';
                submitBtn.disabled = true;

                // Show typing indicator
                const typingDiv = document.createElement('div');
                typingDiv.className = 'mb-2 ai-reply text-muted';
                typingDiv.textContent = 'Thinking...';
                messagesDiv.appendChild(typingDiv);
                messagesDiv.scrollTop = messagesDiv.scrollHeight;

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();

                    if (response.ok) {
                        typingDiv.className = 'mb-2 ai-reply';
                        typingDiv.innerHTML = '<span class="badge bg-success text-wrap text-start p-2">' + (data.reply || '').replace(/</g, '&lt;') + '</span>';
                    } else {
                        typingDiv.className = 'mb-2 ai-reply text-danger';
                        typingDiv.textContent = data.message || 'Something went wrong.';
                    }
                } catch {
                    typingDiv.className = 'mb-2 ai-reply text-danger';
                    typingDiv.textContent = 'Could not reach the AI Companion. Please try again.';
                } finally {
                    submitBtn.disabled = false;
                    messagesDiv.scrollTop = messagesDiv.scrollHeight;
                }
            });
        </script>
    }
</body>

</html>