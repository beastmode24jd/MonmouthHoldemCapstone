@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <div class="banner-img-2" role="img" aria-label="A landscape view of an evergreen forest in sunlight."></div>

    <div class="container ps-0">
        <div class="row g-0">
            <div class="col">
                <h3 class="mainHeader mt-4">What is this app?</h3>
                <p class="displayText">
                    Wildlife AID is a Desktop Application that brings competition, discovery, and education together in the natural world.
                     By blending engaging gameplay with real-world exploration, Wildlife AID transforms 
                     <a href="https://en.wikipedia.org/wiki/Zoology">zoology,</a> botany, and outdoor exploration into an interactive, rewarding experience for everyone.
                </p>

                <h3 class="mainHeader mt-4">How do I register?</h3>
                <p class="displayText">
                    Either by clicking the "Menu" in the upper right of the navigation bar on the application, or by clicking <a href="#">this link.</a>
                </p>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row pb-1 mb-2">
            <div class="col">
                <button aria-label="Account Registration" class="btnDark">Make an account now!</button>
            </div>
        </div>
    </div>

</div>
