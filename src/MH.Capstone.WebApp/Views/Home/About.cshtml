@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">

    <!-- Hero Section -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5">About Wildlife AID</h1>
        <p class="lead text-muted">
            Technology supporting conservation through community-driven wildlife reporting.
        </p>
    </div>

    <!-- What is Wildlife AID -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h3 class="fw-semibold mb-3 text-center">What is Wildlife AID?</h3>
            <p>
                Wildlife AID is a web application designed to support wildlife awareness, reporting, and data organization.
                It provides a structured and accessible way for users to log wildlife sightings and contribute to a growing
                body of environmental information.
            </p>
            <p>
                This application was developed as a senior capstone project and is part of the development team’s
                graduation requirements at <strong>Western Oregon University</strong>.
            </p>
        </div>
    </div>

    <!-- Why It Matters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h3 class="fw-semibold mb-3 text-center">Why It Matters</h3>
            <p>
                Wildlife AID encourages community participation in conservation efforts by making wildlife reporting simple,
                organized, and accessible. By combining modern web technologies with environmental awareness, this project
                demonstrates how software engineering can contribute to real-world ecological impact.
            </p>
            <p class="mb-0">
                Our mission is to use technology to support education, conservation, and responsible wildlife engagement.
            </p>
        </div>
    </div>

