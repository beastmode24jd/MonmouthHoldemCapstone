@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="text-center mb-5">
                <h1 class="fw-bold">About Wildlife AID</h1>
                <p class="text-muted mb-0">
                    Learn why this project exists and meet the team behind it.
                </p>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3 class="fw-semibold mb-3">What is Wildlife AID?</h3>
                    <p class="mb-3">
                        Wildlife AID is a web application designed to support wildlife-related work by making it easier to track, manage, and share important information.
                        The goal is to provide an organized, accessible tool that helps users understand and act on wildlife data more effectively.
                    </p>
                    <p class="mb-0">
                        This application was developed as a capstone project and is part of the development team’s graduation requirements for obtaining a
                        <strong>BS in Computer Science</strong> at <strong>Western Oregon University</strong>.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3 class="fw-semibold mb-4">Meet the Wildlife AID Development and Support Teams</h3>

