@model SightingDetailsViewModel
@{
    ViewData["Title"] = "Sighting Details";

    string rarityBadgeClass = Model.Rarity switch
    {
        "Mythic" => "bg-mythic",
        "Rare"   => "bg-rare",
        "Common" => "bg-common",
        _        => "bg-secondary"
    };
}

<div id="sightingDetailsContainer" class="container mt-4">
    <div class="card shadow">
        <div class="card-body">
            @* CSP-37: success flash after a saved edit. *@
            @if (TempData["EditSuccess"] is string editSuccess)
            {
                <div id="editSuccessMessage" class="alert alert-success" role="alert">@editSuccess</div>
            }
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="card-title mb-0">
                    <i class="bi fillOrange bi-binoculars-fill"></i>
                    Sighting Details
                </h1>
                <div class="d-flex gap-2">
                    @* CSP-37: edit button visible only to the owner (server re-checks on the edit routes). *@
                    @if (Model.CanEdit)
                    {
                        <a id="editSightingLink"
                           asp-controller="Sighting" asp-action="Edit" asp-route-id="@Model.Id"
                           class="btn btn-outline-primary">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                    }
                    <a id="backToGalleryLink"
                       asp-controller="Sighting" asp-action="Gallery"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Gallery
                    </a>
                </div>
            </div>
            <hr />

            <div class="row g-4">
                @* Full sighting image *@
                <div class="col-12 col-lg-7">
                    <img id="sightingDetailsImage"
                         src="@Model.ImageDataUrl"
                         alt="Sighting image"
                         class="img-fluid rounded shadow-sm"
                         style="width: 100%; max-height: 600px; object-fit: contain; background: #f7f7f7;" />
                </div>

                @* Metadata column *@
                <div class="col-12 col-lg-5">
                    @* Uploader attribution *@
                    <div class="d-flex align-items-center mb-3">
                        <img id="sightingDetailsUploaderIcon"
                             src="@Model.UploaderProfileImageDataUrl"
                             alt="Uploader profile picture"
                             class="rounded-circle me-2"
                             style="width: 48px; height: 48px; object-fit: cover;" />
                        <div>
                            <div class="text-muted small">Submitted by</div>
                            <div id="sightingDetailsUploaderName" class="fw-bold">
                                @Model.UploaderDisplayName
                            </div>
                        </div>
                    </div>

                    @* Species *@
                    <div class="mb-3">
                        <div class="text-muted small">Species</div>
                        <div id="sightingDetailsSpecies" class="fs-5 fw-semibold">
                            @Model.SpeciesName
                        </div>
                    </div>

                    @* Rarity badge + point value *@
                    <div class="mb-3 d-flex flex-wrap gap-2">
                        <span class="badge @rarityBadgeClass">
                            @Model.Rarity (@Model.RarityMultiplier.ToString("0.0")x)
                        </span>
                    </div>

                    @* Timestamp *@
                    <div class="mb-3">
                        <div class="text-muted small">When</div>
                        <div id="sightingDetailsTimestamp">
                            <i class="bi bi-clock"></i>
                            @Model.Timestamp.ToString("MMM dd, yyyy h:mm tt")
                        </div>
                    </div>

                    @* Location *@
                    <div class="mb-3">
                        <div class="text-muted small">Location</div>
                        <div id="sightingDetailsLocation">
                            <i class="bi bi-geo-alt-fill"></i>
                            @Model.Latitude.ToString("0.000000"), @Model.Longitude.ToString("0.000000")
                        </div>
                    </div>

                    @* Description (or empty-state placeholder) *@
                    <div class="mb-3">
                        <div class="text-muted small">Description</div>
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <div id="sightingDetailsDescription">@Model.Description</div>
                        }
                        else
                        {
                            <div id="sightingDetailsDescription" class="text-muted fst-italic">
                                No description provided
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Fun fact panel — full width below the photo + meta *@
            <hr />
            <div class="mt-3">
                <h5>
                    <i class="bi bi-lightbulb-fill text-warning"></i>
                    Fun Fact
                </h5>
                <p id="sightingDetailsFunFact"
                   data-fun-fact-status="@(Model.IsFunFactFallback ? "fallback" : "ok")"
                   class="@(Model.IsFunFactFallback ? "text-muted fst-italic" : "")">
                    @Model.FunFact
                </p>
            </div>

            @* CSP-187 AC2: comments section *@
            <hr />
            <div id="sightingComments" class="mt-3">
                <h5>
                    <i class="bi bi-chat-left-text"></i>
                    Comments <span id="commentsCount" class="text-muted small">(@Model.Comments.Count)</span>
                </h5>

                @if (TempData["CommentError"] is string commentError)
                {
                    <div id="commentError" class="alert alert-warning">@commentError</div>
                }

                <form id="newCommentForm" asp-controller="Comments" asp-action="Create"
                      asp-route-sightingId="@Model.Id" method="post" class="mb-3">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <textarea id="commentBody" name="body" class="form-control"
                                  rows="2" maxlength="1000" required
                                  placeholder="Add a comment..."></textarea>
                    </div>
                    <button id="postCommentButton" type="submit" class="btn btnDark btn-sm">
                        <i class="bi bi-send"></i> Post Comment
                    </button>
                </form>

                @if (Model.Comments.Count == 0)
                {
                    <p id="noCommentsMessage" class="text-muted fst-italic">No comments yet.</p>
                }
                else
                {
                    <ul id="commentsList" class="list-group">
                        @foreach (var c in Model.Comments)
                        {
                            <li class="list-group-item comment-item" data-comment-id="@c.Id" data-author-id="@c.AuthorId">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <strong class="comment-author">@c.AuthorDisplayName</strong>
                                        <span class="text-muted small ms-2">
                                            @c.CreatedAt.ToString("MMM dd, yyyy h:mm tt")
                                        </span>
                                    </div>
                                    @if (Model.ViewerCanModerate)
                                    {
                                        <form asp-controller="Comments" asp-action="Hide"
                                              asp-route-commentId="@c.Id"
                                              method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="sightingId" value="@Model.Id" />
                                            <input type="hidden" name="reason" value="Moderator action" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger hide-comment-button"
                                                    aria-label="Hide comment">
                                                <i class="bi bi-eye-slash"></i> Hide
                                            </button>
                                        </form>
                                    }
                                </div>
                                <div class="comment-body mt-1">@c.Body</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
