@model SightingGalleryViewModel
@{
    ViewData["Title"] = "My Sightings Gallery";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">
            <h1 class="card-title">
                <i class="bi bi-camera-fill text-primary"></i> My Sightings Gallery
            </h1>
            <hr />

            @* Display sighting count when user has sightings *@
            @if (Model.HasSightings)
            {
                <p class="text-muted mb-4">
                    <i class="bi bi-images"></i> 
                    You have <strong>@Model.SightingCount</strong> @(Model.SightingCount == 1 ? "sighting" : "sightings")
                </p>
            }

            @* Empty State - shown when user has no sightings *@
            @if (!Model.HasSightings)
            {
                <div class="text-center py-5">
                    <i class="bi bi-binoculars display-1 text-muted mb-3"></i>
                    <h3 class="text-muted">Your Gallery is Empty</h3>
                    <p class="lead text-muted mb-4">
                        Start exploring and upload your first wildlife sighting to earn points and badges!
                    </p>
                    <a asp-controller="Sighting" asp-action="Upload" class="btn btn-primary btn-lg">
                        <i class="bi bi-camera-fill"></i> Upload Your First Sighting
                    </a>
                </div>
            }
            else
            {
                @* Responsive Gallery Grid *@
                <div class="row g-4">
                    @foreach (var sighting in Model.Sightings)
                    {
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="card h-100 shadow-sm sighting-card">
                                @* Sighting Image *@
                                <img src="@sighting.ImageDataUrl" 
                                     class="card-img-top sighting-image" 
                                     alt="Sighting image"
                                     loading="lazy" />
                                
                                @* Card Body with Description and Timestamp *@
                                <div class="card-body d-flex flex-column">
                                    @* Timestamp with icon *@
                                    <p class="card-text text-muted mb-2">
                                        @sighting.PointValue points
                                    </p>

                                    <p class="card-text text-muted small mb-2">
                                        <!-- Timestamp removed for gallery feature -->
                                        Taken at:
                                    </p>
                                    <p class="card-text text-muted small mb-2">
                                        @sighting.Rarity (x @sighting.RarityMultiplier.ToString() multiplier)
                                    </p>

                                    @if (sighting.LoginStreak == true)
                                    {
                                        <p class="card-text text-muted small mb-2">Login Streak (x 1.5 multiplier) applied!</p>
                                    } else {
                                        <p class="card-text text-muted small mb-2">Login Streak inactive.</p>
                                    }
                                    
                                    @* Description - show if exists, otherwise placeholder *@
                                    @if (!string.IsNullOrWhiteSpace(sighting.Description))
                                    {
                                        <p class="card-text flex-grow-1">
                                            @sighting.Description
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="card-text text-muted fst-italic flex-grow-1">
                                            No description provided
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* Custom CSS for gallery cards *@
<style>
    /* Sighting card hover effect */
    .sighting-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        cursor: pointer;
    }
    
    .sighting-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
    
    /* Image styling - maintain aspect ratio and cover */
    .sighting-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        object-position: center;
    }
    
    /* Ensure cards in the same row have equal height */
    .sighting-card {
        height: 100%;
    }
</style>
