@model SightingGalleryViewModel
@{
    ViewData["Title"] = "Sightings Gallery";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">
            <h1 class="card-title">
                <i class="bi bi-camera-fill text-primary"></i> Sightings Gallery
            </h1>
            <hr />

            @* Filter Controls — CSP-96 *@
            <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                <div class="btn-group" role="group" aria-label="Gallery filter">
                    <button id="filterAll" type="button" class="btn btn-primary active">
                        <i class="bi bi-globe"></i> All Sightings
                    </button>
                    <button id="filterMine" type="button" class="btn btn-outline-primary">
                        <i class="bi bi-person-fill"></i> My Sightings
                    </button>
                </div>
                <span id="galleryCountLabel" class="text-muted small"></span>
            </div>

            @* All-Sightings empty state — shown when DB has no sightings at all *@
            @if (!Model.HasSightings)
            {
                <div id="emptyStateAll" class="text-center py-5">
                    <i class="bi bi-binoculars display-1 text-muted mb-3"></i>
                    <h3 class="text-muted">No Sightings Yet</h3>
                    <p class="lead text-muted mb-4">
                        Be the first to explore and upload a wildlife sighting!
                    </p>
                    <a asp-controller="Sighting" asp-action="Upload" class="btn btn-primary btn-lg">
                        <i class="bi bi-camera-fill"></i> Upload Your First Sighting
                    </a>
                </div>
            }

            @* My-Sightings empty state — shown by JS when filter is "mine" and user has no sightings *@
            <div id="emptyStateMine" class="text-center py-5" style="display:none">
                <i class="bi bi-binoculars display-1 text-muted mb-3"></i>
                <h3 class="text-muted">Your Gallery is Empty</h3>
                <p class="lead text-muted mb-4">
                    Start exploring and upload your first wildlife sighting to earn points and badges!
                </p>
                <a asp-controller="Sighting" asp-action="Upload" class="btn btn-primary btn-lg">
                    <i class="bi bi-camera-fill"></i> Upload Your First Sighting
                </a>
            </div>

            @* Responsive Gallery Grid *@
            @if (Model.HasSightings)
            {
                <div id="sightingsGrid" class="row g-4">
                    @foreach (var sighting in Model.Sightings)
                    {
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 sighting-card-wrapper"
                             data-user-id="@sighting.SubmittedByUserId">
                            @* Determine badge display based on rarity score *@
                            @{
                                string rarityBadgeClass = sighting.Rarity switch
                                {
                                    "Mythic" => "bg-purple",   // Custom Purple
                                    "Rare" => "bg-primary",    // Bootstrap Blue
                                    "Common" => "bg-success",  // Bootstrap Green
                                    _ => "bg-secondary"        // Fallback
                                };
                            }
                            @* CSP-172: each card is a link to its details page *@
                            <a class="sighting-card-link"
                               data-sighting-id="@sighting.Id"
                               asp-controller="Sighting" asp-action="Details" asp-route-id="@sighting.Id">
                                <div class="card h-100 shadow-sm sighting-card">
                                    @* Sighting Image *@
                                    <img src="@sighting.ImageDataUrl"
                                         class="card-img-top sighting-image"
                                         alt="Sighting image"
                                         loading="lazy" />

                                    @* Card Body *@
                                    <div class="card-body d-flex flex-column">
                                        @* Attribution — CSP-96 *@
                                        <p class="card-text text-muted small mb-1">
                                            <i class="bi bi-person-circle"></i>
                                            <span class="sighting-attribution">@sighting.SubmittedByUsername</span>
                                        </p>

                                        @* Point value *@
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-primary">@sighting.PointValue points</span>
                                        </div>

                                        @* Timestamp with icon *@
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <small class="text-muted">
                                                <i class="bi bi-clock"></i> @sighting.Timestamp.ToString("MMM dd, yyyy h:mm tt")
                                            </small>
                                        </div>

                                        <div class="mb-3 d-flex flex-wrap align-items-center">
                                            @* Rarity Badge *@
                                            <span class="badge @rarityBadgeClass me-1">
                                                @sighting.Rarity (@sighting.RarityMultiplier.ToString("0.0")x)
                                            </span>

                                            @* Login Streak Badge - Only shown if active *@
                                            @if (sighting.LoginStreak)
                                            {
                                                <span class="badge bg-success">Login Streak (1.5x)</span>
                                            }
                                        </div>

                                        @* Description - show if exists, otherwise placeholder *@
                                        @if (!string.IsNullOrWhiteSpace(sighting.Description))
                                        {
                                            <p class="card-text small flex-grow-1 text-truncate" title="@sighting.Description">
                                                @sighting.Description
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="card-text small text-muted fst-italic flex-grow-1">
                                                No description provided
                                            </p>
                                        }
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }

            @* Pagination controls — CSP-199. Only shown when there is more than one page. *@
            @if (Model.TotalPages > 1)
            {
                <nav id="galleryPagination" aria-label="Sightings gallery pages" class="mt-4">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a id="pagePrev" class="page-link"
                               asp-controller="Sighting" asp-action="Gallery"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               tabindex="@(Model.HasPreviousPage ? "0" : "-1")"
                               aria-disabled="@(Model.HasPreviousPage ? "false" : "true")">
                                <i class="bi bi-chevron-left"></i> Prev
                            </a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="Sighting" asp-action="Gallery"
                                   asp-route-page="@p">@p</a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a id="pageNext" class="page-link"
                               asp-controller="Sighting" asp-action="Gallery"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               tabindex="@(Model.HasNextPage ? "0" : "-1")"
                               aria-disabled="@(Model.HasNextPage ? "false" : "true")">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                    <p class="text-center text-muted small mt-2 mb-0">
                        Page @Model.CurrentPage of @Model.TotalPages · @Model.TotalCount total sightings
                    </p>
                </nav>
            }
        </div>
    </div>
</div>

@* Gallery filter + sessionStorage persistence — CSP-96 *@
@* CSP-221: the current user's ID is read from the shared #currentUserId span in
   _Layout.cshtml (its text content). We deliberately do NOT render a second
   element with that id here — a duplicate id caused getElementById to return the
   layout span (which has no data-user-id), leaving the filter with an empty id
   that matched no cards. *@
<script>
    (function () {
        const STORAGE_KEY = 'galleryFilter';
        const currentUserId = (document.getElementById('currentUserId')?.textContent ?? '').trim();

        const filterAllBtn = document.getElementById('filterAll');
        const filterMineBtn = document.getElementById('filterMine');
        const emptyStateMine = document.getElementById('emptyStateMine');
        const emptyStateAll = document.getElementById('emptyStateAll');
        const countLabel = document.getElementById('galleryCountLabel');

        function applyFilter(filter) {
            sessionStorage.setItem(STORAGE_KEY, filter);

            const cards = document.querySelectorAll('.sighting-card-wrapper');
            let visibleCount = 0;

            if (filter === 'mine') {
                filterAllBtn.classList.remove('btn-primary', 'active');
                filterAllBtn.classList.add('btn-outline-primary');
                filterMineBtn.classList.remove('btn-outline-primary');
                filterMineBtn.classList.add('btn-primary', 'active');

                cards.forEach(function (card) {
                    // CSP-221: compare case-insensitively. Stored UserIdentityId is written
                    // lowercase (Guid.ToString()) while CurrentUserId is the raw Identity Id,
                    // so a case-sensitive === could hide the user's own sightings.
                    if ((card.dataset.userId ?? '').toLowerCase() === currentUserId.toLowerCase()) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (emptyStateAll) {
                    emptyStateAll.style.display = 'none';
                }
                if (emptyStateMine) {
                    emptyStateMine.style.display = visibleCount === 0 ? '' : 'none';
                }
                if (countLabel) {
                    countLabel.textContent = visibleCount === 0
                        ? ''
                        : visibleCount + ' ' + (visibleCount === 1 ? 'sighting' : 'sightings');
                }
            } else {
                filterAllBtn.classList.add('btn-primary', 'active');
                filterAllBtn.classList.remove('btn-outline-primary');
                filterMineBtn.classList.add('btn-outline-primary');
                filterMineBtn.classList.remove('btn-primary', 'active');

                cards.forEach(function (card) {
                    card.style.display = '';
                    visibleCount++;
                });

                if (emptyStateAll) {
                    emptyStateAll.style.display = visibleCount === 0 ? '' : 'none';
                }
                if (emptyStateMine) {
                    emptyStateMine.style.display = 'none';
                }
                if (countLabel) {
                    countLabel.textContent = visibleCount + ' ' + (visibleCount === 1 ? 'sighting' : 'sightings');
                }
            }
        }

        if (filterAllBtn) {
            filterAllBtn.addEventListener('click', function () { applyFilter('all'); });
        }
        if (filterMineBtn) {
            filterMineBtn.addEventListener('click', function () { applyFilter('mine'); });
        }

        // Restore persisted filter on page load
        const saved = sessionStorage.getItem(STORAGE_KEY) || 'all';
        applyFilter(saved);
    })();
</script>

@* Custom CSS for gallery cards *@
<style>
    .sighting-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        cursor: pointer;
    }

    .sighting-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .sighting-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        object-position: center;
    }

    /* CSP-172: each card is a link, but should not look like a hyperlink */
    .sighting-card-link {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    .sighting-card-link:hover,
    .sighting-card-link:focus {
        color: inherit;
        text-decoration: none;
    }
</style>
