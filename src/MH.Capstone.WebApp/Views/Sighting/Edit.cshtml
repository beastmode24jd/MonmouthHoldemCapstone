@model SightingEditViewModel
@{
    ViewData["Title"] = "Edit Sighting";
}

<div id="editSightingContainer" class="container mt-4">
    <div class="card shadow">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="card-title mb-0">
                    <i class="bi bi-pencil-square text-primary"></i>
                    Edit Sighting
                </h1>
                <a id="cancelEditLink"
                   asp-controller="Sighting" asp-action="Details" asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
            </div>
            <hr />

            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="row g-4">
                @* Read-only context: photo, GPS, timestamp are frozen at submission. *@
                <div class="col-12 col-lg-6">
                    <img id="editSightingImage"
                         src="@Model.ImageDataUrl"
                         alt="Sighting image"
                         class="img-fluid rounded shadow-sm"
                         style="width: 100%; max-height: 400px; object-fit: contain; background: #f7f7f7;" />

                    <div class="mt-3">
                        <div class="text-muted small">When</div>
                        <div id="editSightingTimestamp">
                            <i class="bi bi-clock"></i>
                            @Model.Timestamp.ToString("MMM dd, yyyy h:mm tt")
                        </div>
                    </div>
                    <div class="mt-2">
                        <div class="text-muted small">Location</div>
                        <div id="editSightingLocation">
                            <i class="bi bi-geo-alt-fill"></i>
                            @Model.Latitude.ToString("0.000000"), @Model.Longitude.ToString("0.000000")
                        </div>
                    </div>
                </div>

                @* Editable fields. *@
                <div class="col-12 col-lg-6">
                    <form id="editSightingForm"
                          asp-controller="Sighting" asp-action="Edit" asp-route-id="@Model.Id"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="SpeciesName" class="form-label"></label>
                            <input asp-for="SpeciesName" id="editSpeciesField"
                                   class="form-control" maxlength="100"
                                   placeholder="e.g. Great Horned Owl" />
                            <span asp-validation-for="SpeciesName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" id="editDescriptionField"
                                      class="form-control" rows="6" maxlength="500"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <button id="saveEditBtn" type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Save Changes
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
