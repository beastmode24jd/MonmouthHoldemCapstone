@model SightingUploadViewModel
@{
    ViewData["Title"] = "Upload Sighting";
}
<h1 class="mt-2">Upload Sighting</h1>
<form asp-action="Upload" asp-controller="Sighting" method="post" enctype="multipart/form-data">
    <div class="row">
        <div class="form-group col-md-4 col-12">
            <label asp-for="Latitude"></label>
            <input asp-for="Latitude" class="form-control" id="latitudeInput" data-js-numericOnly />
            <span asp-validation-for="Latitude" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4 col-12">
            <label asp-for="Longitude"></label>
            <input asp-for="Longitude" class="form-control" id="longitudeInput" data-js-numericOnly />
            <span asp-validation-for="Longitude" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4 col-12">
            <label asp-for="Timestamp"></label>
            <input asp-for="Timestamp"
            type="datetime-local"
            class="form-control"
            value="@Model.Timestamp.ToString("yyyy-MM-ddTHH:mm")"/>
            <span asp-validation-for="Timestamp" class="text-danger"></span>
        </div>
        <input type="hidden" asp-for="DeviceTimezone" />
    </div>
    
    <!-- Location status message -->
    <div class="row mt-2">
        <div class="col-12">
            <div id="locationStatus" class="alert d-none" role="alert"></div>
        </div>
    </div>
    
    <!-- Use Current Location button -->
    <div class="row mb-2">
        <div class="col-12">
            <button type="button" id="useCurrentLocationBtn" class="btn btn-outline-secondary">
                <i class="bi bi-geo-alt"></i> Use Current Location
            </button>
        </div>
    </div>
    
    <div class="row mb-md-3 mb-2">
        <div class="form-group col-lg-8 col-12">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="10"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="form-group col-lg-4 col-12">
            <label asp-for="UploadedImage">Upload Image</label><br />
            <input asp-for="UploadedImage" type="file" accept=".png,.jpeg,.jpg" class="form-control-file" id="imageUploadInput" />
            <span asp-validation-for="UploadedImage" class="text-danger d-block"></span>
            <!-- Image preview -->
            <img id="imagePreview" src="" alt="Uploaded Image Preview" class="d-none mt-2" style="max-width: 200px; max-height: 200px;"/>
        </div>
    </div>
    @Html.AntiForgeryToken()

    @* CSP-144: AI Photo Recognition. Button is disabled until a file is chosen.
       The three status containers (badge / not-identified / error) start hidden
       and are toggled by sighting-upload.js based on the /SightingAI/Identify response. *@
    <div class="row mb-md-3 mb-2">
        <div class="col-12">
            <button type="button" id="identifyAIBtn" class="btn btn-outline-info" disabled>
                <i class="bi bi-stars"></i> Identify with AI
            </button>

            <div id="aiSuggestionBadge" class="alert alert-success mt-2 d-none" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                AI suggests: <strong><span id="aiSuggestionSpecies"></span></strong>
            </div>

            <div id="aiNotIdentifiedMessage" class="alert alert-warning mt-2 d-none" role="alert">
                <i class="bi bi-question-circle-fill"></i>
                Could not identify a species in this photo. Try a clearer shot or describe it manually below.
            </div>

            <div id="aiErrorToast" class="alert alert-danger mt-2 d-none" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span id="aiErrorMessage">Could not reach the AI service. Please try again.</span>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary" id="SubmitBtn">Submit</button>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/exif-js@2.3.0/exif.min.js"></script>
    <script src="~/js/sighting-upload.js" asp-append-version="true"></script>
}
