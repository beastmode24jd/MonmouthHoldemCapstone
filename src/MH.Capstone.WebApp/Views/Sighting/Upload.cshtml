@model MH.Capstone.WebApp.Models.ViewModels.SightingUploadViewModel
@{
    ViewData["Title"] = "Upload Sighting";
}

<h1>Upload Sighting</h1>

<form asp-action="Upload" method="post" enctype="multipart/form-data">
    <div class="row">
        <div class="form-group col-md-4 col-12">
            <label asp-for="Latitude"></label>
            <input asp-for="Latitude" class="form-control" data-js-numericOnly />
            <span asp-validation-for="Latitude" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4 col-12">
            <label asp-for="Longitude"></label>
            <input asp-for="Longitude" class="form-control" data-js-numericOnly />
            <span asp-validation-for="Longitude" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4 col-12">
            <label asp-for="Timestamp"></label>
            <input asp-for="Timestamp" type="datetime-local" class="form-control"/>
            <span asp-validation-for="Timestamp" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="form-group col-lg-8 col-12">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="10"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
@*         <div class="form-group col-lg-4 col-12">
            <label for="Image">Upload Image</label><br/>
            <input type="file" name="Image" class="form-control-file" />
            <span asp-validation-for="" class="text-danger"></span>
            <img src="" width="100px" height="100px" alt="Uploaded Image" class="d-none"/>
        </div> *@
    </div>

    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-primary">Submit</button>
</form>