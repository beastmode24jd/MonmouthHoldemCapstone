@model SightingUploadViewModel
@{
    ViewData["Title"] = "Upload Sighting";
}
<span id="currentUserId" class="d-none">@ViewBag.CurrentUserId</span>

<div class="container mt-4 mb-3 pb-3">
    <div class="card shadow">
        <h1 class="card-header card-title mb-0 mainHeader"> <i class="bi bi-camera fillOrange"></i> Upload Sighting</h1>
        <div class="card-body">
            @* CSP-193: surface validation errors (e.g. NotDefaultCoordinates from CSP-146,
            which lands on Latitude+Longitude keys) so the user can see *why* the form
            was rejected — without it, class-level errors are invisible. *@
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <form id="sightingUploadForm" asp-action="Upload" asp-controller="Sighting" method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="form-group col-md-4 col-12">
                        <label asp-for="Latitude"></label>
                        <input asp-for="Latitude" class="form-control" id="latitudeInput" data-js-numericOnly />
                        <span asp-validation-for="Latitude" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-4 col-12">
                        <label asp-for="Longitude"></label>
                        <input asp-for="Longitude" class="form-control" id="longitudeInput" data-js-numericOnly />
                        <span asp-validation-for="Longitude" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-4 col-12">
                        <label asp-for="Timestamp"></label>
                        <input asp-for="Timestamp"
                        type="datetime-local"
                        class="form-control"
                        value="@Model.Timestamp.ToString("yyyy-MM-ddTHH:mm")"/>
                        <span asp-validation-for="Timestamp" class="text-danger"></span>
                    </div>
                    <input type="hidden" asp-for="DeviceTimezone" />
                    <input type="hidden" asp-for="ClientSightingId" id="clientSightingIdInput" />
                </div>

                <!-- Location status message -->
                <div class="row mt-2">
                    <div class="col-12">
                        <div id="locationStatus" class="alert d-none" role="alert"></div>
                    </div>
                </div>

                <!-- Use Current Location button -->
                <div class="row mb-2">
                    <div class="col-12">
                        <button type="button" id="useCurrentLocationBtn" class="btn bg-orange">
                            <i class="bi bi-geo-alt"></i> Use Current Location
                        </button>
                    </div>
                </div>

                @* CSP-142: Species input. Required for Anidex grouping.
                Auto-filled by sighting-upload.js when the AI returns a confident match. *@
                <div class="row mb-md-3 mb-2">
                    <div class="form-group col-12">
                        <label asp-for="SpeciesName"></label>
                        <input asp-for="SpeciesName"
                            class="form-control"
                            id="SpeciesName"
                            placeholder="e.g. Great Horned Owl"
                            maxlength="100" />
                        <small class="form-text text-muted">
                            Don't know? Upload your photo first, then click <em>Identify with AI</em> below.
                        </small>
                        <span asp-validation-for="SpeciesName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-md-3 mb-2">
                    <div class="form-group col-lg-8 col-12">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" class="form-control" rows="10"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-group col-lg-4 col-12">
                        <label asp-for="UploadedImage">Upload Image</label><br />
                        <input asp-for="UploadedImage" type="file" accept=".png,.jpeg,.jpg" class="form-control-file mt-2" id="imageUploadInput" />
                        <span asp-validation-for="UploadedImage" class="text-danger d-block"></span>
                        <!-- Image preview -->
                        <img id="imagePreview" src="" alt="Uploaded Image Preview" class="d-none mt-2" style="max-width: 200px; max-height: 200px;"/>
                    </div>
                </div>
                @Html.AntiForgeryToken()

                @* CSP-144: AI Photo Recognition. Button is disabled until a file is chosen.
                The three status containers (badge / not-identified / error) start hidden
                and are toggled by sighting-upload.js based on the /SightingAI/Identify response. *@
                <div class="row mb-md-3 mb-2">
                    <div class="col-12">
                        <button type="button" id="identifyAIBtn" class="btn bg-midGreen-outline mb-1" disabled>
                            <i class="bi bi-stars"></i> Identify with AI
                        </button>

                        <div id="aiSuggestionBadge" class="alert alert-success mt-2 d-none" role="alert">
                            <i class="bi bi-check-circle-fill"></i>
                            AI suggests: <strong><span id="aiSuggestionSpecies"></span></strong>
                        </div>

                        <div id="aiNotIdentifiedMessage" class="alert alert-warning mt-2 d-none" role="alert">
                            <i class="bi bi-question-circle-fill"></i>
                            Could not identify a species in this photo. Try a clearer shot or describe it manually below.
                        </div>

                        <div id="aiErrorToast" class="alert alert-danger mt-2 d-none" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span id="aiErrorMessage">Could not reach the AI service. Please try again.</span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn bg-orange" id="SubmitBtn">Submit</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/exif-js@2.3.0/exif.min.js"></script>
    <script src="~/js/sighting-upload.js" asp-append-version="true"></script>
}
