@{
    ViewData["Title"] = "Manage Roles";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">
            <h2 class="card-title">User Role Management</h2>
            <hr />

            @* Alert/Notification message area *@
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <p class="text-muted">Enter a user's email to promote them to the Admin role.</p>

            <form id="promoteForm" asp-action="PromoteToAdmin" method="post" class="mt-3">
                <input type="hidden" name="adminPassword" class="modal-password-target" />
                <div class="mb-3 col-md-6">
                    <label for="email" class="form-label">User Email</label>
                    <input type="email" name="email" id="email" class="form-control" required />
                </div>
                <button type="button" class="btn btn-primary" onclick="showPasswordModal('promoteForm')">
                    Elevate to Admin
                </button>
            </form>
            
            <hr class="my-4" />

            <h4 class="text-danger"><i class="bi bi-person-dash"></i> Revoke Admin Rights</h4>
            <p class="text-muted">Enter a user's email to remove them from the Admin role.</p>
            <form id="demoteForm" asp-action="DemoteFromAdmin" method="post" class="mt-3">
                <input type="hidden" name="adminPassword" class="modal-password-target" />
                <div class="mb-3 col-md-6">
                    <label for="demoteEmail" class="form-label">User Email</label>
                    <input type="email" name="email" id="demoteEmail" class="form-control" required />
                </div>
                <button type="button" class="btn btn-outline-danger" onclick="showPasswordModal('demoteForm')">
                    Revoke Admin Status
                </button>
            </form>

            <hr class="my-4" />

            <div class="row">
                <div class="col-md-6 border-end">
                    <h4><i class="bi bi-lock-fill text-warning"></i> Lock User Account</h4>
                    <form id="lockForm" asp-action="ToggleAccountLock" method="post">
                        <input type="hidden" name="adminPassword" class="modal-password-target" />
                        <input type="hidden" name="shouldLock" value="true" />
                        <input type="hidden" name="targetEmail" class="selected-email" required />
                        
                        <div class="mb-3">
                            <label class="form-label">Search Active Users</label>
                            <input type="text" id="activeUserSearch" class="form-control user-search" 
                                data-find-locked="false" list="lockList" placeholder="Type to search...">
                            <datalist id="lockList"></datalist>
                        </div>
                        <button type="button" id="lockBtn" class="btn btn-warning" onclick="showPasswordModal('lockForm')">
                            Lock Account
                        </button>
                    </form>
                </div>

                <div class="col-md-6">
                    <h4><i class="bi bi-unlock-fill text-success"></i> Unlock User Account</h4>
                    <form id="unlockForm" asp-action="ToggleAccountLock" method="post">
                        <input type="hidden" name="adminPassword" class="modal-password-target" />
                        <input type="hidden" name="shouldLock" value="false" />
                        <input type="hidden" name="targetEmail" class="selected-email" required />
                        
                        <div class="mb-3">
                            <label class="form-label">Search Locked Users</label>
                            <input type="text" id="lockedUserSearch" class="form-control user-search" 
                                data-find-locked="true" list="unlockList" placeholder="Type to search...">
                            <datalist id="unlockList"></datalist>
                        </div>
                        <button type="button" class="btn btn-success" id="unlockBtn" onclick="showPasswordModal('unlockForm')">
                            Restore Access
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@* Admin password check modal (hidden initially) *@
<div class="modal fade" id="adminPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Administrator Verification</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Please enter your administrator password to authorize this action.</p>
                <div class="mb-3">
                    <label for="modalAdminPassword" class="form-label">Password</label>
                    <input type="password" id="modalAdminPassword" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmAuthBtn">Confirm Action</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Include the external JS file *@
    <script src="~/js/manageAccounts.js"></script>
}