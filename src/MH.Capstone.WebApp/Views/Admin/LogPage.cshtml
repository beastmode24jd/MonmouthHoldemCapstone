@model MH.Capstone.WebApp.Models.AuditQueueViewModel
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container mt-4">
    @Html.AntiForgeryToken()
    <h2 class="card-title">Action Auditing Log</h2>
    <hr />
    <p>This should be locked from regular users!</p>

    <table class="table table-hover shadow-sm">
        <thead class="table-dark align-center">
            <tr>
                <th>Category</th>
                <th>Admin</th>
                <th>User</th>
                <th>Date</th>
                <th>Page</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var audit in Model.Audits)
            {
                <tr class="text">
                    <td>@audit.ActionType
                        @* Put a switch case here for better display (spaces in the titles)*@
                    </td>
                    <td>@audit.PerformingUser.DisplayName</td>
                    <td>
                        @(audit.TargetUser.DisplayName == null ? "N/A" : audit.TargetUser.DisplayName);
                    </td>
                    <td>@audit.Timestamp.ToString("MMM dd, yyyy h:mm tt")</td>
                    <td>
                        @(audit.TargetReport != null && audit.TargetReport.ReportedPageUrl != null)
                        {
                            <a href="@audit.TargetReport!.ReportedPageUrl" target="_blank"
                            class="text-decoration-none btn-link text-primary small">Link</a>
                        } else {
                            "N/A";
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-success btn-outline-white details-btn"
                            data-id="@audit.Id"
                            data-description="@(audit.Details ?? "No description")">
                            Details
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    @* <a class="page-link" asp-action="Audits" 
                       asp-route-CurrentPage="@i" 
                       asp-route-ShowResolved="@Model.ShowResolved"
                       asp-route-SortBy="@Model.SortBy">@i</a> *@
                </li>
            }
        </ul>
    </nav> 
</div>

@* Initially hidden report details modal *@
<div class="modal fade" id="auditDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Audit Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="fw-bold">Details from Admin:</label>
                    <div class="p-2 border bg-light ticketDesc" id="auditDetailsDiv" style="white-space: pre-wrap;">
                        @* Content filled via JS *@
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* <script src="~/js/notWrittenHereYet.js"></script> *@
}