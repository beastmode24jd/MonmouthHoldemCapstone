@model MH.Capstone.WebApp.Models.ReportQueueViewModel
@{
    ViewData["Title"] = "Report Queue";
}

<div class="container mt-4">
    <h2 class="card-title">Admin Report Queue</h2>
    <hr />
    <form asp-action="Reports" method="get" class="row g-3 mb-4">
        @* Search Bars (page URL and User search) *@
        <div class="row g-3 mb-2">
            <div class="col-md-6">
                <label class="form-label fw-bold">Search URL</label>
                <input asp-for="PageUrlFilter" class="form-control" placeholder="https://wildlifeAID..." />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Ticket Reporter</label>
                <input asp-for="UserSearch" class="form-control" placeholder="Username here..." />
            </div>
        </div>


        @* Filter Toggles & Actions *@
        <div class="row g-3 mt-0">
            <div class="col-md-3">
                <label class="form-label fw-bold">Date Filter</label>
                <input asp-for="DateFilter" type="date" class="form-control" 
                       value="@Model.DateFilter?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Status</label>
                <select asp-for="ShowResolved" class="form-select">
                    <option value="">All</option> 
                    <option value="false">Unresolved</option>
                    <option value="true">Resolved</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Sort Descending by:</label>
                <select asp-for="SortBy" asp-items="Model.SortOptions" class="form-select"></select>
            </div>
            @* Submit and Clear buttons *@
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-dark flex-grow-1">Filter</button>
                <a asp-action="Reports" class="btn btn-secondary flex-grow-1">Clear</a>
            </div>
        </div>
    </form>

    <table class="table table-hover shadow-sm">
        <thead class="table-dark align-center">
            <tr>
                <th>Date</th>
                <th>Reporter</th>
                <th>Page</th>
                <th>Reason</th>
                <th class="text-center">Resolved</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model.Reports)
            {
                <tr class="text">
                    <td>@report.SubmittedAt.ToShortDateString()</td>
                    <td>@report.Reporter.DisplayName</td>
                    <td>
                        <a href="@report.ReportedPageUrl" target="_blank"
                        class="text-decoration-none btn-link text-primary small">Link</a></td>
                    <td>@report.Reason</td>
                    <td class="text-center align-center">
                    @* Displays marked or unmarked static checkbox, for Resolved/Unresolved status *@
                        <input type="checkbox" class="form-check-input" 
                           @(report.IsResolved ? "checked" : "") disabled />
                    </td>
                    <td>
                        <button class="btn btn-sm btn-btn-secondary btn-outline-success">Details</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Reports" 
                       asp-route-CurrentPage="@i" 
                       asp-route-ShowResolved="@Model.ShowResolved"
                       asp-route-SortBy="@Model.SortBy">@i</a>
                </li>
            }
        </ul>
    </nav>     
</div>