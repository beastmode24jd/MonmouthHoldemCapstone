@model AnidexViewModel
@{
    ViewData["Title"] = "Anidex";
}

<div class="container mt-4 mb-3 pb-3">
    <div class="card shadow">
        <div class="mainHeader">
            <h1 class="card-title">
                <i class="bi fillGreen bi-collection-fill"></i> Anidex
            </h1>
        </div>
        <div class="card-body notebook">
            <p class="text text-sm mb-0">
                Every unique species you've confirmed through your sightings — your personal field guide.
            </p>
            @if (Model.IsEmpty)
            {
                <div id="anidexEmptyState" class="text-center py-5">
                    <i class="bi bi-binoculars display-1 text-muted mb-3"></i>
                    <h3 class="text-muted">Your Anidex is Empty</h3>
                    <p class="lead text-muted mb-4">
                        Go explore! Upload your first sighting and a species will appear here.
                    </p>
                    <a asp-controller="Sighting" asp-action="Upload" class="btn bg-orange btn-lg">
                        <i class="bi bi-camera-fill"></i> Upload Your First Sighting
                    </a>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center mb-3 mt-2">
                    <span id="anidexSpeciesCount" class="text fillOrange pb-1 pt-1">
                        @Model.TotalSpecies @(Model.TotalSpecies == 1 ? "species" : "species") discovered
                    </span>
                </div>

                <div id="anidexGrid" class="row g-4">
                    @for (int i = 0; i < Model.Entries.Count; i++)
                    {
                        var entry = Model.Entries[i];
                        string rarityBadgeClass = entry.RarityName switch
                        {
                            "Mythic" => "bg-mythic",
                            "Rare" => "bg-rare",
                            "Common" => "bg-common",
                            _ => "bg-secondary"
                        };
                        string modalId = $"anidexModal-{i}";
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 anidex-entry"
                             data-species-name="@entry.SpeciesName">
                            <div class="card h-100 shadow-sm anidex-card">
                                @if (entry.OffersExpansion)
                                {
                                    <button type="button"
                                            class="anidex-card-toggle"
                                            data-bs-toggle="modal"
                                            data-bs-target="#@modalId">
                                        @* card face — identical content to a plain card, made clickable *@
                                        @if (entry.LatestSightingId.HasValue)
                                        {
                                            <img src="/anidex/image/@(entry.LatestSightingId)"
                                                 width="400" height="180" decoding="async"
                                                 class="card-img-top anidex-image"
                                                 alt="@entry.SpeciesName"
                                                 loading="lazy" />
                                        }
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title anidex-species-name mb-2">@entry.SpeciesName</h5>

                                            <div class="mb-2">
                                                <span class="badge @rarityBadgeClass anidex-rarity-badge">
                                                    @entry.RarityName (@entry.RarityMultiplier.ToString("0.0")x)
                                                </span>
                                            </div>

                                            <p class="card-text small text-muted mb-1">
                                                <i class="bi bi-camera"></i>
                                                Discovered <span class="anidex-discovery-count">@entry.DiscoveryCount</span>
                                                @(entry.DiscoveryCount == 1 ? "time" : "times")
                                            </p>

                                            <p class="card-text small text-muted mt-auto mb-0">
                                                <i class="bi bi-clock"></i>
                                                Last seen @entry.LatestSightingTimestamp.ToString("MMM dd, yyyy")
                                            </p>

                                            <p class="card-text small text-primary fw-semibold mt-2 mb-0 anidex-expand-hint">
                                                <i class="bi bi-images"></i>
                                                <span class="anidex-expand-hint-label">View all @entry.DiscoveryCount sightings</span>
                                            </p>
                                        </div>
                                    </button>
                                }
                                else
                                {
                                    @if (entry.LatestSightingId.HasValue)
                                    {
                                        <img src="/anidex/image/@(entry.LatestSightingId)" width="400" height="180" decoding="async"
                                             class="card-img-top anidex-image"
                                             alt="@entry.SpeciesName"
                                             loading="lazy" />
                                    }

                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title anidex-species-name mb-2">@entry.SpeciesName</h5>

                                        <div class="mb-2">
                                            <span class="badge @rarityBadgeClass anidex-rarity-badge">
                                                @entry.RarityName (@entry.RarityMultiplier.ToString("0.0")x)
                                            </span>
                                        </div>

                                        <p class="card-text small text-muted mb-1">
                                            <i class="bi bi-camera"></i>
                                            Discovered <span class="anidex-discovery-count">@entry.DiscoveryCount</span>
                                            @(entry.DiscoveryCount == 1 ? "time" : "times")
                                        </p>

                                        <p class="card-text small text-muted mt-auto mb-0">
                                            <i class="bi bi-clock"></i>
                                            Last seen @entry.LatestSightingTimestamp.ToString("MMM dd, yyyy")
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* CSP-202: per-species detail modals rendered OUTSIDE #anidexGrid.
   The card's :hover transform creates a containing block that would otherwise
   re-anchor a position:fixed modal to the card instead of the viewport. *@
@for (int i = 0; i < Model.Entries.Count; i++)
{
    var entry = Model.Entries[i];
    if (!entry.OffersExpansion) { continue; }
    string modalId = $"anidexModal-{i}";
    string labelId = $"anidexModalLabel-{i}";
    <div class="modal fade anidex-modal" id="@modalId" tabindex="-1"
         aria-labelledby="@labelId" aria-hidden="true"
         data-species-modal="@entry.SpeciesName">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="@labelId">
                        @entry.SpeciesName
                        <span class="text-muted fs-6">— @entry.DiscoveryCount sightings</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul class="list-unstyled mb-0 anidex-expand-list">
                        @foreach (var sighting in entry.Entries)
                        {
                            <li class="anidex-expand-entry py-3 border-top"
                                data-sighting-id="@sighting.SightingId">
                                <div class="row g-3 align-items-center">
                                    <div class="col-4 col-md-3">
                                        @if (sighting.SightingId != Guid.Empty)
                                        {
                                            <img src="/anidex/image/@(sighting.SightingId)" decoding="async"
                                                 class="img-fluid rounded anidex-expand-image"
                                                 alt="@entry.SpeciesName sighting"
                                                 loading="lazy" />
                                        }
                                    </div>
                                    <div class="col-8 col-md-9">
                                        <p class="small text-muted anidex-expand-timestamp mb-1">
                                            <i class="bi bi-clock"></i>
                                            @sighting.Timestamp.ToString("MMM dd, yyyy h:mm tt")
                                        </p>
                                        <p class="mb-0 anidex-expand-description">
                                            @(string.IsNullOrWhiteSpace(sighting.Description) ? "(no description)" : sighting.Description)
                                        </p>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .anidex-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

    .anidex-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .anidex-image {
        width: 100%;
        height: 180px;
        object-fit: cover;
        object-position: center;
    }

    /* CSP-202: card-as-button must be visually identical to a plain card body. */
    .anidex-card-toggle {
        background: transparent;
        border: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        text-align: left;
        color: inherit;
        cursor: pointer;
        display: flex;
        flex-direction: column;
    }

    .anidex-card-toggle:focus-visible {
        outline: 2px solid var(--bs-primary);
        outline-offset: 2px;
        border-radius: 0.375rem;
    }

    .anidex-expand-image {
        width: 100%;
        max-height: 90px;
        object-fit: cover;
    }
</style>
