@model List<MH.Capstone.Domain.DataModels.Notification>
@{
    ViewData["Title"] = "Notifications";
}

@section Styles
{
    <style>
        /* Simple modern styles for notifications table-like list */
        .notifications-card {
            border: 0;
        }

        .notifications-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 0.5rem;
        }

        .notifications-table thead th {
            border: 0;
            background: transparent;
        }

        .notification-row {
            transition: background-color .18s ease, transform .08s ease;
            border-radius: .5rem;
            overflow: hidden;
        }

        .notification-row:hover {
            transform: translateY(-1px);
        }

        /* unread notifications should stand out slightly with a semi-transparent background */
        .notification-row.unread {
            background-color: rgba(253, 157, 13, 0.065); /* subtle Bootstrap primary tint */
            box-shadow: 0 1px 0 rgba(13,110,253,0.04) inset;
        }

        .notification-title {
            color: #29341c;
            font-weight: 600;
            font-size: 1rem;
        }

        .notification-message {
            color: #4e4340;
            font-size: 0.95rem;
            margin-top: 0.25rem;
            white-space: pre-wrap;
        }

        .notification-actions {
            width: 180px;
            text-align: right;
            vertical-align: middle;
        }

        .btn-icon {
            padding: .35rem .6rem;
        }

    </style>
}

<div class="container mt-3 mb-5 pb-4 pb-md-0">
    <div class="card notifications-card shadow-sm">
        <div class="mainHeader">
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center mb-2 mt-1">
                <h3 class="mb-0 card-title text-light text-nowrap">
                    <i class="bi fillOrange bi-bell-fill me-2"></i>Your Notifications
                </h3>
                
                @{
                    var hasUnread = Model != null && Model.Any(n => !n.IsRead);
                    var hasAny = Model != null && Model.Any();
                }

                <div class="d-flex gap-2 ms-md-auto mt-3 mt-md-0 w-100 w-md-auto justify-content-start justify-content-md-end">
                    <form id="markAllReadForm" asp-action="MarkAllNotificationsAsRead" asp-controller="Dashboard" class="m-0 @(hasUnread ? "" : "d-none")">
                        @Html.AntiForgeryToken()
                        <button type="submit" id="markAllReadBtn" class="btn btn-sm bg-midGreen text-nowrap">
                            <i class="bi bi-check2-all me-1"></i>Mark All as Read
                        </button>
                    </form>
                    <form id="deleteAllForm" asp-action="DeleteAllNotifications" asp-controller="Dashboard" class="m-0 @(hasAny ? "" : "d-none")">
                        @Html.AntiForgeryToken()
                        <button type="submit" id="deleteAllBtn" class="btn btn-sm bg-orange text-nowrap">
                            <i class="bi bi-trash me-1"></i>Delete All
                        </button>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="card-body mt-1 mb-5 mb-md-2 pb-4 pb-md-1">

            @if (Model == null || !Model.Any())
            {
                <div id="notificationsEmptyState" class="alert alert-success" role="alert"> @* AND THIS *@
                    You have no notifications at this time. Way to stay on top of things!
                </div>
            }
            else
            {
                <table class="notifications-table">
                    <thead>
                    <tr>
                        <th class="text-start">Notification</th>
                        <th class="notification-actions">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var n in Model)
                    {
                        var rowClass = n.IsRead ? "notification-row" : "notification-row unread";
                        <tr class="@rowClass" data-notif-id="@n.Id">
                            <td class="px-3 py-3 align-middle">
                                <div class="notification-title">@n.Title</div>
                                <div class="notification-message">@n.Message</div>
                            </td>
                            <td class="notification-actions px-3 py-3">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    @{
                                        var readBtnDisplayClass = n.IsRead ? "d-none" : string.Empty;
                                        var unreadBtnDisplayClass = n.IsRead ? string.Empty : "d-none";
                                    }
                                    <form asp-action="UpdateNotification" asp-controller="Dashboard" asp-route-nid="@n.Id" data-notif-id="@n.Id"
                                        class="m-0 notificationUpdateForm">
                                        <input type="hidden" name="toggleRead" value="true" />
                                        @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm bg-midGreen btn-icon @readBtnDisplayClass" title="Mark as read" data-notif-id="@n.Id-read">
                                            <i class="bi bi-check2-circle"></i>
                                            <span class="visually-hidden">Mark as read</span>
                                        </button>
                                            <button type="submit" class="btn btn-sm bg-midGreen-outline btn-icon @unreadBtnDisplayClass" title="Mark as unread" data-notif-id="@n.Id-unread">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                            <span class="visually-hidden">Mark as unread</span>
                                        </button>
                                    </form>
                                    <form asp-action="DeleteNotification" asp-controller="Dashboard" asp-route-nid="@n.Id" data-notif-id="@n.Id"
                                        class="m-0 notificationDeleteForm">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm bg-orange btn-icon btn-delete" title="Delete notification">
                                            <i class="bi bi-trash"></i>
                                            <span class="visually-hidden">Delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/notifications.js" asp-append-version="true"></script>
}