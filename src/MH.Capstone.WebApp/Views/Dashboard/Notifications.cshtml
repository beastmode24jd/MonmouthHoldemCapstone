@model List<MH.Capstone.Domain.DataModels.Notification>
@{
    ViewData["Title"] = "Notifications";
}

@section Styles
{
    <style>
        /* Simple modern styles for notifications table-like list */
        .notifications-card {
            border: 0;
        }

        .notifications-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 0.5rem;
        }

        .notifications-table thead th {
            border: 0;
            background: transparent;
        }

        .notification-row {
            transition: background-color .18s ease, transform .08s ease;
            border-radius: .5rem;
            overflow: hidden;
        }

        .notification-row:hover {
            transform: translateY(-1px);
        }

        /* unread notifications should stand out slightly with a semi-transparent background */
        .notification-row.unread {
            background-color: rgba(13,110,253,0.06); /* subtle Bootstrap primary tint */
            box-shadow: 0 1px 0 rgba(13,110,253,0.04) inset;
        }

        .notification-title {
            font-weight: 600;
            font-size: 1rem;
        }

        .notification-message {
            color: #6c757d;
            font-size: 0.95rem;
            margin-top: 0.25rem;
            white-space: pre-wrap;
        }

        .notification-actions {
            width: 180px;
            text-align: right;
            vertical-align: middle;
        }

        .btn-icon {
            padding: .35rem .6rem;
        }

    </style>
}

<div class="container mt-4">
    <div class="card notifications-card shadow-sm">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <h3 class="mb-0 card-title"><i class="bi bi-bell-fill me-2"></i>Your Notifications</h3>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info" role="alert">
                    You have no notifications at this time. Way to stay on top of things!
                </div>
            }
            else
            {
                <table class="notifications-table">
                    <thead>
                    <tr>
                        <th class="text-start">Notification</th>
                        <th class="notification-actions">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var n in Model)
                    {
                        var rowClass = n.IsRead ? "notification-row" : "notification-row unread";
                        <tr class="@rowClass" data-notif-id="@n.Id">
                            <td class="px-3 py-3 align-middle">
                                <div class="notification-title">@n.Title</div>
                                <div class="notification-message">@n.Message</div>
                            </td>
                            <td class="notification-actions px-3 py-3">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    @{
                                        var readBtnDisplayClass = n.IsRead ? "d-none" : string.Empty;
                                        var unreadBtnDisplayClass = n.IsRead ? string.Empty : "d-none";
                                    }
                                    <form asp-action="UpdateNotification" asp-controller="Dashboard" asp-route-nid="@n.Id" data-notif-id="@n.Id"
                                        class="m-0 notificationUpdateForm">
                                        <input type="hidden" name="toggleRead" value="true" />
                                        @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success btn-icon @readBtnDisplayClass" title="Mark as read" data-notif-id="@n.Id-read">
                                            <i class="bi bi-check2-circle"></i>
                                            <span class="visually-hidden">Mark as read</span>
                                        </button>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary btn-icon @unreadBtnDisplayClass" title="Mark as unread" data-notif-id="@n.Id-unread">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                            <span class="visually-hidden">Mark as unread</span>
                                        </button>
                                    </form>
                                    <form asp-action="DeleteNotification" asp-controller="Dashboard" asp-route-nid="@n.Id" data-notif-id="@n.Id"
                                        class="m-0 notificationDeleteForm">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger btn-icon btn-delete" title="Delete notification">
                                            <i class="bi bi-trash"></i>
                                            <span class="visually-hidden">Delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
        function isTableEmpty() {
            const table = document.querySelector('.notifications-table');
            const tbody = table && table.tBodies && table.tBodies[0];
            return !tbody || tbody.rows.length === 0;
        }

        document.addEventListener('DOMContentLoaded',
            function() {
                // Attach submit event to all notification update forms
                document.querySelectorAll('.notificationUpdateForm').forEach(form => {
                    form.addEventListener('submit',
                        function(e) {
                            e.preventDefault(); // Prevent default form submission
                            const notifId = this.getAttribute('data-notif-id');
                            const toggleReadValue = this.querySelector('input[name="toggleRead"]').value;
                            fetch(this.action,
                                    {
                                        method: 'PUT',
                                        headers: {
                                            'Content-Type': 'application/x-www-form-urlencoded',
                                            'RequestVerificationToken': this.querySelector('input[name="__RequestVerificationToken"]').value
                                        },
                                        body: new URLSearchParams({
                                            toggleRead: toggleReadValue
                                        })
                                    })
                                .then(response => {
                                    if (response.ok) {
                                        // On success, toggle the row's unread class & the button's appearance
                                        const row = document.querySelector(`tr[data-notif-id="${notifId}"]`);
                                        const readBtn = this.querySelector(`button[data-notif-id="${notifId}-read"]`);
                                        const unreadBtn = this.querySelector(`button[data-notif-id="${notifId}-unread"]`);
                                        if (row) {
                                            row.classList.toggle('unread');
                                            readBtn.classList.toggle('d-none');
                                            unreadBtn.classList.toggle('d-none');
                                        }

                                        // Refresh (not by reload) the notifications badge in the navbar
                                        notificationAlertRefresh();
                                    } else {
                                        console.error('Failed to update notification status.');
                                    }
                                })
                                .catch(error => console.error('Error:', error));
                        });
                });

                // ---------------------------
                // Delete handler (AJAX) - prevents page reload, removes row, calls notificationAlertRefresh()
                // ---------------------------
                document.querySelectorAll('.notificationDeleteForm').forEach(form => {
                    form.addEventListener('submit',
                        async function(e) {
                            e.preventDefault();

                            // Optional: confirm delete with the user
                            if (!confirm('Delete this notification? This action cannot be undone.')) {
                                return;
                            }

                            const btn = this.querySelector('.btn-delete');
                            const notifId = this.getAttribute('data-notif-id');

                            if (!notifId) {
                                console.error('Notification id not found on delete form.');
                                return;
                            }

                            try {
                                // Disable button to prevent duplicate clicks
                                if (btn) {
                                    btn.disabled = true;
                                    btn.classList.add('disabled');
                                }

                                // Send DELETE to delete endpoint. Body carries notification id in case server needs it.
                                const res = await fetch(this.action,
                                    {
                                        method: 'DELETE',
                                        headers: {
                                            'Content-Type': 'application/x-www-form-urlencoded',
                                            'RequestVerificationToken': this.querySelector('input[name="__RequestVerificationToken"]').value
                                        }
                                    });

                                if (!res.ok) {
                                    console.error('Failed to delete notification', res.status);
                                    if (btn) {
                                        btn.disabled = false;
                                        btn.classList.remove('disabled');
                                    }
                                    return;
                                }

                                // Remove the table row corresponding to the deleted notification
                                const row = document.querySelector(`tr[data-notif-id="${notifId}"]`);
                                if (row) {
                                    // small fade-out for good UX
                                    row.style.transition = 'opacity 220ms ease, height 220ms ease, margin 220ms ease';
                                    row.style.opacity = '0';
                                    row.style.height = '0';
                                    row.style.margin = '0';
                                    // Remove from DOM after transition
                                    setTimeout(() => {
                                        row.remove();
                                        if (isTableEmpty()) {
                                            // no notifications left - refresh the page to show the "no notifications" message 
                                            // (simpler than dynamically inserting it here since a reload won't load any notifications)
                                            location.reload();
                                        }
                                    },
                                    240);
                                };

                                // Update the notifications badge/alert count
                                if (typeof notificationAlertRefresh === 'function') {
                                    notificationAlertRefresh();
                                }
                            } catch
                            (err) {
                                console.error('Error deleting notification:', err);
                                if (btn) {
                                    btn.disabled = false;
                                    btn.classList.remove('disabled');
                                }
                            }
                        });
                });
            });
    </script>
}