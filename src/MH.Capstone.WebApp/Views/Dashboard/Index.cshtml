@inject Microsoft.AspNetCore.Identity.UserManager<MH.Capstone.Domain.DataModels.ApplicationUser> _userManager
@{
    ViewData["Title"] = "Dashboard";
    var user = await _userManager.GetUserAsync(User);
    var badges = ViewData["SortedBadges"] as List<MH.Capstone.Domain.DataModels.UserBadge>;

    // Fetch user Role
    string? displayRole = null;
    if (user != null)
    {
        var userRoles = await _userManager.GetRolesAsync(user);
        if (userRoles.Contains("Admin"))
        {
            displayRole = "Admin";
        }
        else
        {
            displayRole = userRoles.FirstOrDefault() ?? "User";
        }
    }

    // Fetch the device's local time zone for display
    var userTimeZoneId = ViewData["UserTimeZone"] as string ?? "America/Los_Angeles";
    string formattedLastLogin = "Never";

    if (user?.LastLogin != null)
    {
        try 
        {
            var tzInfo = TimeZoneInfo.FindSystemTimeZoneById(userTimeZoneId);
            var localTime = TimeZoneInfo.ConvertTime(user.LastLogin.Value, tzInfo);
            formattedLastLogin = localTime.ToString("MMM dd, yyyy h:mm tt");
        }
        catch (Exception)
        {
            // Fallback for safety
            formattedLastLogin = user.LastLogin.Value.ToString("yyyy-MM-dd HH:mm UTC");
        }
    }
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <h1 class="card-title">Welcome to Your Dashboard</h1>
                    <hr />
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="alert alert-success" role="alert">
                            <h4 class="alert-heading mb-3">
                                <img src="@user.GetProfileImageUrl()"
                                     class="dashboardProfile" 
                                role="img" />

                                 Hello, @User.Identity.Name!
                            </h4>
                            @Html.Raw(ViewData["statusMsgHtml"])
                        </div>

                        <div class="mt-4 mb-2">
                            <h5>Your Account Information</h5>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item">
                                    <strong>Email:</strong> @User.Identity.Name
                                </li>
                                <li class="list-group-item">
                                    <strong>Authentication Type:</strong> @User.Identity.AuthenticationType
                                </li>
                                <li class="list-group-item">
                                    <strong>Account Type:</strong> 
                                    @if (!string.IsNullOrEmpty(displayRole))
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-shield-check"></i> @displayRole</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Standard User</span>
                                    }
                                </li>
                                <li class="list-group-item">
                                    <strong>Status:</strong> <span class="badge bg-success">Active</span>
                                </li>
                                <li class="list-group-item">
                                    <strong>Bio: </strong> @(user?.Bio ?? "No custom bio is set.")
                                </li>
                                <li class="list-group-item mt-1">
                                    <p class="text-muted small mb-0 pb-0">
                                        Last Login: @formattedLastLogin
                                    </p>
                                </li>
                            </ul>
                        </div>

                        <div class="mt-4">
                            <form asp-action="Logout" asp-controller="Account" method="post">
                                <button type="submit" class="dropdown-menu">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            You are not logged in. Please <a asp-action="Login" asp-controller="Account">login</a> to access your dashboard.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4 mb-8">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-bell"></i> Notifications
                    </h5>
                    <button class="btn btnDark position-relative" onclick="window.location = '@Url.Action("Notifications", "Dashboard")'">
                        View your Notifications
                        @if (user != null && user.Notifications.Exists(n => !n.IsRead))
                        {
                            <span class="position-absolute top-0 start-100 translate-middle p-2 bg-danger border border-light rounded-circle">
                                <span class="visually-hidden">Unread notifications</span>
                            </span>
                        }
                    </button>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title mb-2">
                        <i class="bi bi-speedometer2"></i> Quick Stats
                    </h5>
                    <div class="row g-3 mt-1">
                        <div class="col-4 text-left mt-1 mb-1">
                            <p class="card-text mb-0 mt-1"><strong>Current points:</strong> <br/>@(user?.Points ?? 0) </p>
                        </div>
                        <div class="col-4 text-left mt-1 mb-1">
                            @if (user != null)
                            {
                                <p class="card-text mb-0 mt-1"><strong>Login Streak:</strong> </p>
                                <span class="badge @(user.IsStreakActive ? "bg-success" : "bg-danger")">
                                    @(user.IsStreakActive ? "Active" : "Inactive")
                                </span>
                            }
                        </div>
                        <div class="col-4 text-left mt-1 mb-1">
                            <p class="card-text mb-0 mt-1"><strong>Current Streak:</strong>
                                @if (user?.LoginStreak > 1 && user?.LoginStreak != null)
                                {
                                    @user.LoginStreak <p> Days</p>
                                }
                                else if (user?.LoginStreak == 1 && user?.LoginStreak != null)
                                { <p>1 day</p> }
                                else
                                { <p>0 Days</p> }
                            </p>
                        </div>
                    </div>
                    <strong><p class="card-text mb-1 mt-2">Recent Badges:</p></strong>
                    <div class="mb-2 mt-0">
                        @if(badges != null && badges.Any())
                        {
                            <div class="row g-3">
                                @foreach(var ub in badges.Take(3)) // Show 3 most recent badges
                                {
                                    <div class="col-4 text-center">
                                        <div class="card h-100 border-3">
                                            <div class="card-body p-3">
                                                <img src="~/imgs/badge/BadgeIcon1.jpg" class="dashboardProfile" role="img"/>
                                                <br><strong>@ub.Badge.Title</strong> 
                                                <br>@ub.Badge.PointValue points
                                                <br><small class="text-muted">@ub.BadgeEarned?.ToString("MMM dd, yyyy h:mm tt")</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="col text-left">
                                <div class="card h-100 border-0">
                                    <div class="card-body pt-1 pb-1">
                                        <p class="form-text">No badges yet. Hint: try uploading a custom profile image!</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-4 mb-4">
        <div class="col-mb-4">
            <div class="card shadow">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-gear"></i> Account Settings
                    </h5>
                    <p class="card-text mb-1 mt-3">Upload your profile picture:</p>
                    <form id="uploadForm" asp-action="UploadProfileImage" method="Post" enctype="multipart/form-data">
                        <input id="fileInput" class="form-control form-control-sm mb-3 mt-2" type="file" accept="image/*" name="profilePicture" />
                        <button type="submit" class="btnDark">Upload Image</button>
                    </form>
                    <br>
                    <p class="card-text mb-1">Update your profile bio:</p>
                    <form id="bioForm" asp-action="UpdateUserBio" method="Post">
                        <div class="mb-3 mt-1">
                            <textarea id="bioInput" name="newBio" class="form-control" rows="3" maxlength="250" placeholder="Tell us about yourself..."></textarea>
                            <div class="form-text">Profile bio should be 250 characters or less.</div>
                            <span id="charCount" class="form-text">0/250</span>
                            <div id="bioErrorMsg" class="text-danger fw-bold small mt-1" style="display:none;"></div>
                        </div>
                        <button type="submit" class="btnDark">Update Bio</button>
                    </form>
                    <br>
                    <p class="card-text mb-2">Account Deactivation:</p>
                    <a asp-action="Deactivate" asp-controller="Account" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-person-x"></i> Deactivate Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>