@model MH.Capstone.WebApp.Models.NotificationPreferencesViewModel
@{
    ViewData["Title"] = "Notification Preferences";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <a href="/dashboard" class="btn btn-outline-secondary btn-sm me-3">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
                <h2 class="mb-0">Notification Preferences</h2>
            </div>

            @if (TempData["NotificationPreferencesSuccess"] != null)
            {
                <div id="notificationPreferenceSuccess" class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["NotificationPreferencesSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <p class="mb-0 text-muted small">
                        Choose how you want to receive each type of notification.
                        System and account notifications are always delivered to both in-app and email.
                    </p>
                </div>
                <div class="card-body p-0">
                    <form id="notificationPreferencesForm" asp-action="SaveNotificationPreferences" method="post">
                        @Html.AntiForgeryToken()
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Notification Type</th>
                                    <th>Description</th>
                                    <th class="pe-4" style="min-width:180px">Delivery</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Preferences.Count; i++)
                                {
                                    var entry = Model.Preferences[i];
                                    <tr>
                                        <td class="ps-4 align-middle fw-semibold">
                                            @entry.DisplayName
                                            <input type="hidden" name="Preferences[@i].NotificationType" value="@((int)entry.NotificationType)" />
                                        </td>
                                        <td class="align-middle text-muted small">@entry.Description</td>
                                        <td class="pe-4 align-middle">
                                            <select id="pref_@entry.NotificationType"
                                                    name="Preferences[@i].SelectedChannel"
                                                    class="form-select form-select-sm">
                                                <option value="@((int)MH.Capstone.Domain.DataModels.NotificationDeliveryChannel.Silenced)"
                                                        selected="@(entry.SelectedChannel == MH.Capstone.Domain.DataModels.NotificationDeliveryChannel.Silenced)">
                                                    Silence
                                                </option>
                                                <option value="@((int)MH.Capstone.Domain.DataModels.NotificationDeliveryChannel.InAppOnly)"
                                                        selected="@(entry.SelectedChannel == MH.Capstone.Domain.DataModels.NotificationDeliveryChannel.InAppOnly)">
                                                    In-App Only
                                                </option>
                                                <option value="@((int)MH.Capstone.Domain.DataModels.NotificationDeliveryChannel.EmailOnly)"
                                                        selected="@(entry.SelectedChannel == MH.Capstone.Domain.DataModels.NotificationDeliveryChannel.EmailOnly)">
                                                    Email Only
                                                </option>
                                                <option value="@((int)MH.Capstone.Domain.DataModels.NotificationDeliveryChannel.InAppAndEmail)"
                                                        selected="@(entry.SelectedChannel == MH.Capstone.Domain.DataModels.NotificationDeliveryChannel.InAppAndEmail)">
                                                    In-App &amp; Email
                                                </option>
                                            </select>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="d-flex justify-content-end p-3 border-top">
                            <button id="saveNotificationPreferencesBtn" type="submit" class="btn btn-primary">
                                Save Preferences
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
