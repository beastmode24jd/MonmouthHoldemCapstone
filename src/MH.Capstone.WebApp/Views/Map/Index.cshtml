@{
    ViewData["Title"] = "Sightings Map";
}

<div class="container mt-4 mb-3 pb-3">
    <div class="row g-0">
        <div class="col-12">
            
            <div class="card-header mainHeader text-white py-2 d-inline-block" 
                 style="padding-left: 1rem; padding-right: 1.5rem; width: auto; border-bottom: none; z-index: 2; position: relative; margin: 0 !important;">
                <h5 class="mb-0 text-white"><i class="bi bi-geo-alt-fill me-2 fillOrange"></i>Map</h5>
            </div>

            <div class="map-outline-wrapper position-relative" style="z-index: 1;">
                
                <div id="map-loading-overlay" class="d-flex flex-column justify-content-center align-items-center" 
                     style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: #fdfbf7; z-index: 1000; transition: opacity 0.4s ease;">
                    <div class="spinner-border text-secondary mb-2" role="status"></div>
                    <span class="text-muted small">Loading map...</span>
                </div>

                <div id="map-container" style="height: calc(100vh - 120px); width: 100%;">
                    <div id="map" style="height: 100%; width: 100%;"></div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- No Sightings Modal -->
<div class="modal fade" id="noSightingsModal" tabindex="-1" aria-labelledby="noSightingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white subheader">
                <h5 class="modal-title text-white" id="noSightingsModalLabel">
                    <i class="bi bi-info-circle fillOrange"></i> No Sightings Found
                </h5>
            </div>
            <div class="modal-body">
                <p>There are no wildlife sightings in this area yet.</p>
                <p>Be the first to report a sighting!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn bg-midGreen" data-bs-dismiss="modal">Continue Exploring</button>
                <a asp-controller="Sighting" asp-action="Upload" class="btn bg-orange">
                    <i class="bi bi-camera"></i> Upload Sighting
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
            
            #map-container {
                position: relative;
            }
            .leaflet-container {
                background-color: #f0f0f0;
            }
            
            .map-outline-wrapper {
                border: 2px solid #ffffff; /* Thinner white border */
                border-top-right-radius: 12px;
                border-bottom-left-radius: 12px;
                border-bottom-right-radius: 12px;
                border-top-left-radius: 0; 
                overflow: hidden; 
                margin-top: 0px;
            }

            /* 2. Invert the Leaflet Zoom Controls */
            .leaflet-control-zoom a {
                background-color: #154224 !important; /* Dark green background */
                color: #c6e292 !important; /* Light green text/icons */
                border: 1px solid #1d6234 !important;
            }

            .leaflet-control-zoom a:hover {
                background-color: #1d6234 !important; /* Slightly lighter green on hover */
                color: #ffffff !important;
            }
            
            /* (Keep your existing .location-error-banner style here as well) */
            /* ... */
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        (function () {
            // Default location (Portland, Oregon as fallback)
            const defaultLat = 45.5152;
            const defaultLng = -122.6784;
            const defaultZoom = 13;

            let map;
            let userMarker;
            let sightingsLoaded = false;
            let sightingMarkers = []; // Track sighting markers

            // Initialize the map
            function initMap(lat, lng, zoom) {
                // Constrain panning + tile wrapping so the world only renders once.
                // Without this, Leaflet/OSM repeat the world infinitely east/west and
                // markers (which live at real lat/lng) don't appear on the duplicate copies.
                const worldBounds = L.latLngBounds([-90, -180], [90, 180]);

                map = L.map('map', {
                    maxBounds: worldBounds,
                    maxBoundsViscosity: 1.0,
                    minZoom: 2,
                    worldCopyJump: false
                }).setView([lat, lng], zoom);

                // Test hook: acceptance BDD reads/drives the Leaflet instance via this handle.
                window.__sightingsMap = map;

                // Add OpenStreetMap tiles — noWrap stops OSM from drawing repeating copies.
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    noWrap: true,
                    bounds: worldBounds,
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                }).addTo(map);

                // Add user location marker if we have their location
                if (lat !== defaultLat || lng !== defaultLng) {
                    userMarker = L.marker([lat, lng], {
                        icon: L.divIcon({
                            className: 'user-location-marker',
                            html: '<i class="bi bi-geo-alt-fill" style="font-size: 24px; color: #0d6efd;"></i>',
                            iconSize: [24, 24],
                            iconAnchor: [12, 24]
                        })
                    }).addTo(map);
                    userMarker.bindPopup('<strong>Your Location</strong>').openPopup();
                }

                // Load sightings when map moves
                map.on('moveend', loadSightings);

                // Initial load
                loadSightings();
            }

            // Create custom icon for sightings
            function createSightingIcon() {
                return L.divIcon({
                    className: 'sighting-marker',
                    html: '<i class="bi bi-eye-fill" style="font-size: 28px; color: #198754; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);"></i>',
                    iconSize: [28, 28],
                    iconAnchor: [14, 28],
                    popupAnchor: [0, -28]
                });
            }

            // Clear existing sighting markers
            function clearSightingMarkers() {
                sightingMarkers.forEach(marker => map.removeLayer(marker));
                sightingMarkers = [];
            }

            // Load sightings for the current map view
            function loadSightings() {
                const bounds = map.getBounds();
                const params = new URLSearchParams({
                    minLat: bounds.getSouth(),
                    maxLat: bounds.getNorth(),
                    minLng: bounds.getWest(),
                    maxLng: bounds.getEast()
                });

                fetch(`/Map/Sightings?${params}`)
                    .then(response => response.json())
                    .then(sightings => {
                        // Show modal if no sightings and this is the first load
                        if (sightings.length === 0 && !sightingsLoaded) {
                            const modal = new bootstrap.Modal(document.getElementById('noSightingsModal'));
                            modal.show();
                        }
                        sightingsLoaded = true;

                        // Clear existing markers
                        clearSightingMarkers();

                        // Add markers for each sighting
                        sightings.forEach(sighting => {
                            const marker = L.marker([sighting.lat, sighting.lng], {
                                icon: createSightingIcon()
                            }).addTo(map);

                            // Create popup content
                            const popupContent = `
                                <div class="sighting-popup" style="min-width: 200px; max-width: 300px;">
                                    <img src="${sighting.imageUrl}" 
                                         alt="Sighting" 
                                         style="width: 100%; max-height: 200px; object-fit: cover; border-radius: 3px; margin-bottom: 10px;"
                                         onerror="this.style.display='none'">
                                    <p style="margin: 5px 0;"><strong>Description:</strong> ${sighting.description || 'No description provided'}</p>
                                    <p style="margin: 5px 0;"><strong>Spotted:</strong> ${sighting.timestamp}</p>
                                    <p style="margin: 5px 0; font-size: 0.85em; color: #666;">
                                        <i class="bi bi-geo"></i> ${parseFloat(sighting.lat).toFixed(4)}, ${parseFloat(sighting.lng).toFixed(4)}
                                    </p>
                                </div>
                            `;

                            marker.bindPopup(popupContent);
                            sightingMarkers.push(marker);
                        });

                        // Fade out and remove the loading overlay
                        const overlay = document.getElementById('map-loading-overlay');
                        if (overlay) {
                            overlay.style.opacity = '0';
                            setTimeout(() => overlay.remove(), 400); // Wait for transition, then remove from DOM
                        }
                    })
                    .catch(error => {
                        console.error('Error loading sightings:', error);
                        // Also hide the overlay if there's an error so the map is still accessible
                        const overlay = document.getElementById('map-loading-overlay');
                        if (overlay) overlay.style.display = 'none';
                    });
            }

            // Show error banner
            function showLocationError(message) {
                const banner = document.createElement('div');
                banner.className = 'location-error-banner';
                banner.innerHTML = `<i class="bi bi-exclamation-triangle"></i> ${message}`;
                document.getElementById('map-container').appendChild(banner);

                // Remove after 5 seconds
                setTimeout(() => banner.remove(), 5000);
            }

            // Try to get user's location
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function (position) {
                        // Success - use user's location
                        initMap(position.coords.latitude, position.coords.longitude, defaultZoom);
                    },
                    function (error) {
                        // Error - use default location
                        console.warn('Geolocation error:', error.message);
                        showLocationError('Could not determine your location. Showing default area.');
                        initMap(defaultLat, defaultLng, defaultZoom);
                    },
                    {
                        enableHighAccuracy: true,
                        timeout: 10000,
                        maximumAge: 300000 // Cache for 5 minutes
                    }
                );
            } else {
                // Geolocation not supported
                showLocationError('Geolocation is not supported by your browser.');
                initMap(defaultLat, defaultLng, defaultZoom);
            }
        })();
    </script>
}