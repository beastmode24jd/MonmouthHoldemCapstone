@model List<MH.Capstone.Domain.ApiContracts.Ninjas.AnimalApiDto>
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Species Search";
    var initialJson = JsonConvert.SerializeObject(Model ?? new List<MH.Capstone.Domain.ApiContracts.Ninjas.AnimalApiDto>());
}
<div class="species-search-root">
    <section class="search-panel" aria-labelledby="searchHeading">
        <h2 id="searchHeading">Species Search</h2>

        <form id="searchForm" method="get" asp-action="Search" asp-controller="Species" role="search" autocomplete="off">
            <label for="nameInput" class="visually-hidden">Animal name</label>
            <input id="nameInput" name="name" type="search" class="text-input" placeholder="Search by name…" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Search</button>
                <button type="button" id="clearBtn" class="btn btn-secondary">Clear</button>
            </div>
        </form>

        <div id="searchStatus" class="status" aria-live="polite"></div>
    </section>

    <section class="results-panel" aria-labelledby="resultsHeading">
        <h2 id="resultsHeading" class="sr-only">Search results</h2>

        <div id="resultsContainer" class="results-container">
            <div id="resultCard" class="result-card" aria-live="polite">Loading…</div>

            <div class="pagination" aria-label="Result navigation">
                <button id="prevBtn" class="btn" disabled aria-label="Previous result">Previous</button>
                <span id="resultCounter" class="counter" aria-atomic="true">0 / 0</span>
                <button id="nextBtn" class="btn" disabled aria-label="Next result">Next</button>
            </div>
        </div>
    </section>
</div>

@section Styles
{
    <style>
        :root{
            --gap: 1rem;
            --panel-bg: #fff;
            --muted: #6c757d;
            --card-shadow: 0 2px 8px rgba(0,0,0,.06);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        }
        .species-search-root{
            display:flex;
            flex-direction:column;
            gap:var(--gap);
            padding:1rem;
        }

        /* Panels */
        .search-panel, .results-panel{
            background:var(--panel-bg);
            padding:1rem;
            border-radius:8px;
            box-shadow:var(--card-shadow);
        }

        /* Form */
        .text-input{
            width:100%;
            padding:.6rem .75rem;
            font-size:1rem;
            border:1px solid #ddd;
            border-radius:6px;
            margin-bottom:.5rem;
        }
        .form-actions{
            display:flex;
            gap:.5rem;
        }
        .btn{
            padding:.5rem .75rem;
            border:1px solid transparent;
            background:#eee;
            border-radius:6px;
            cursor:pointer;
        }
        .btn-primary{
            background:#0d6efd;
            color:white;
        }
        .btn-secondary{
            background:#6c757d;
            color:white;
        }

        /* Result card */
        .results-container{
            display:flex;
            flex-direction:column;
            gap:var(--gap);
        }
        .result-card{
            min-height:160px;
            padding:1rem;
            border-radius:8px;
            background:linear-gradient(180deg,#fff,#fafbff);
            display:flex;
            gap:1rem;
            align-items:flex-start;
            box-shadow:var(--card-shadow);
        }
        .result-image{
            width:160px;
            height:120px;
            object-fit:cover;
            border-radius:8px;
            background:#f2f2f2;
            flex-shrink:0;
        }
        .result-body{
            flex:1;
        }
        .result-title{
            margin:0 0 .25rem 0;
            font-weight:600;
            font-size:1.1rem;
        }
        .result-sub{
            color:var(--muted);
            font-size:.95rem;
            margin:0 0 .5rem 0;
        }
        .result-meta{
            font-size:.9rem;
            color:#333;
        }

        .pagination{
            display:flex;
            align-items:center;
            gap:.5rem;
        }
        .counter{
            color:var(--muted);
            font-weight:600;
        }

        /* Responsive layout: on wider screens show two columns */
        @@media (min-width:900px){
            .species-search-root{
                flex-direction:row;
            }
            .search-panel{
                width:36%;
                max-width:420px;
            }
            .results-panel{
                width:64%;
            }
        }

        /* Utility */
        .visually-hidden{ position:absolute!important; height:1px; width:1px; overflow:hidden; clip:rect(1px,1px,1px,1px); white-space:nowrap;}
        .sr-only{ position:absolute!important; left:-10000px; top:auto; width:1px; height:1px; overflow:hidden; }
    </style>
}

@section Scripts
{
    <script>
        // Initial data from server (if any)
        const initialResults = @Html.Raw(initialJson ?? "[]");

        let results = Array.isArray(initialResults) ? initialResults : [];
        let currentIndex = 0;

        const resultCard = document.getElementById('resultCard');
        const resultCounter = document.getElementById('resultCounter');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const searchForm = document.getElementById('searchForm');
        const nameInput = document.getElementById('nameInput');
        const searchStatus = document.getElementById('searchStatus');
        const clearBtn = document.getElementById('clearBtn');

        function setStatus(text){
            searchStatus.textContent = text || '';
        }

        function normalizeKey(k){
            return k ? k.toString() : '';
        }

        function renderResult(index){
            if(!results || results.length === 0){
                resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
                resultCounter.textContent = '0 / 0';
                prevBtn.disabled = true;
                nextBtn.disabled = true;
                return;
            }

            const i = Math.max(0, Math.min(index, results.length - 1));
            currentIndex = i;
            const item = results[i];

            // Try common property names for primary fields
            const name = item?.name ?? item?.Name ?? item?.commonName ?? item?.CommonName ?? 'Unknown';
            const sci = item?.scientificName ?? item?.ScientificName ?? item?.latinName ?? item?.LatinName;
            const desc = item?.description ?? item?.Description ?? item?.summary ?? '';
            const image = item?.imageUrl ?? item?.ImageUrl ?? item?.thumbnail ?? item?.Thumbnail;

            let html = '';

            if(image){
                html += `<img src="${escapeHtml(String(image))}" alt="${escapeHtml(String(name))}" class="result-image" loading="lazy" />`;
            }

            html += '<div class="result-body">';
            html += `<h3 class="result-title">${escapeHtml(String(name))}</h3>`;
            if(sci) html += `<div class="result-sub">${escapeHtml(String(sci))}</div>`;
            if(desc) html += `<div class="result-meta">${escapeHtml(String(desc))}</div>`;

            // Render other attributes in a small list (only show simple primitives)
            const known = new Set(['name','Name','commonName','CommonName','scientificName','ScientificName','latinName','LatinName','description','Description','summary','imageUrl','ImageUrl','thumbnail','Thumbnail','id','Id']);
            const entries = Object.entries(item || {})
                .filter(([k,v]) => !known.has(k) && (typeof v === 'string' || typeof v === 'number' || typeof v === 'boolean'))
                .slice(0, 10);

            if(entries.length){
                html += '<dl class="result-meta">';
                for(const [k,v] of entries){
                    html += `<dt style="font-weight:600;margin-top:.5rem;">${escapeHtml(k)}</dt><dd style="margin:0 0 .5rem 0;">${escapeHtml(String(v))}</dd>`;
                }
                html += '</dl>';
            }

            html += '</div>'; // result-body

            resultCard.innerHTML = html;
            resultCounter.textContent = `${currentIndex + 1} / ${results.length}`;

            prevBtn.disabled = currentIndex <= 0;
            nextBtn.disabled = currentIndex >= results.length - 1;
        }

        function escapeHtml(unsafe){
            return (unsafe ?? '').toString()
                .replaceAll('&','&amp;')
                .replaceAll('<','&lt;')
                .replaceAll('>','&gt;')
                .replaceAll('"','&quot;')
                .replaceAll("'",'&#039;');
        }

        async function doSearch(name){
            setStatus('');
            if(!name || name.trim().length === 0){
                setStatus('Please enter a name to search.');
                return;
            }

            setStatus('Searching…');
            try{
                const url = new URL('@Url.Action("Search", "Species")', window.location.origin);
                url.searchParams.set('name', name);

                const resp = await fetch(url.toString(), {
                    method:'GET',
                    headers: { 'Accept': 'application/json' }
                });

                if(!resp.ok){
                    const txt = await resp.text();
                    throw new Error(txt || resp.statusText);
                }

                const data = await resp.json();
                results = Array.isArray(data) ? data : [];
                currentIndex = 0;
                renderResult(currentIndex);
                setStatus(`${results.length} result(s)`);
            }catch(err){
                console.error(err);
                setStatus('Search failed. ' + (err?.message ?? ''));
                results = [];
                renderResult(0);
            }
        }

        // Wire up form with AJAX and graceful fallback (form action exists for non-JS)
        searchForm.addEventListener('submit', function(e){
            e.preventDefault();
            const q = nameInput.value;
            doSearch(q);
        });

        prevBtn.addEventListener('click', function(){ if(currentIndex > 0){ currentIndex -= 1; renderResult(currentIndex); }});
        nextBtn.addEventListener('click', function(){ if(currentIndex < results.length - 1){ currentIndex += 1; renderResult(currentIndex); }});

        clearBtn.addEventListener('click', function(){
            nameInput.value = '';
            results = [];
            currentIndex = 0;
            renderResult(0);
            setStatus('');
        });

        // Initialize view with server-provided model (if any)
        document.addEventListener('DOMContentLoaded', function(){
            renderResult(0);
            if(results && results.length){
                setStatus(`${results.length} result(s)`);
            }
        });
    </script>
}