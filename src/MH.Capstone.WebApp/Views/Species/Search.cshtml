@model List<MH.Capstone.Domain.ApiContracts.Ninjas.AnimalApiDto>
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Species Search";
    var initialJson = JsonConvert.SerializeObject(Model ?? new List<MH.Capstone.Domain.ApiContracts.Ninjas.AnimalApiDto>());
}
<div class="species-search-root">
    <section class="search-panel" aria-labelledby="searchHeading">
        <h2 id="searchHeading">Species Search</h2>

        <form id="searchForm" method="get" asp-action="SearchByName" asp-controller="Species" role="search" autocomplete="off">
            @Html.AntiForgeryToken()
            <label for="nameInput" class="visually-hidden">Animal name</label>
            <input id="nameInput" name="name" type="search" class="text-input" placeholder="Search by name…" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Search</button>
                <button type="button" id="clearBtn" class="btn btn-secondary">Clear</button>
            </div>
        </form>

        <div id="searchStatus" class="status" aria-live="polite"></div>
    </section>

    <section class="results-panel" aria-labelledby="resultsHeading">
        <h2 id="resultsHeading" class="sr-only">Search results</h2>

        <div id="resultsContainer" class="results-container">
            <div id="resultCard" class="result-card" aria-live="polite">
                @if (Model != null && Model.Any())
                {
                    //@Html.Partial("_AnimalResult", Model.First())
                    <partial name="_AnimalResult" model="Model.First()"/>
                }
                else
                {
                    <div class="result-body"><p class="result-sub">No results.</p></div>
                }
            </div>

            <div class="pagination" aria-label="Result navigation">
                <button id="prevBtn" class="btn" disabled aria-label="Previous result">Previous</button>
                <span id="resultCounter" class="counter" aria-atomic="true">0 / 0</span>
                <button id="nextBtn" class="btn" disabled aria-label="Next result">Next</button>
            </div>
        </div>
    </section>
</div>

@section Styles
{
    <style>
        :root{
            --gap: 1rem;
            --panel-bg: #fff;
            --muted: #6c757d;
            --card-shadow: 0 2px 8px rgba(0,0,0,.06);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        }
        .species-search-root{
            display:flex;
            flex-direction:column;
            gap:var(--gap);
            padding:1rem;
        }

        /* Panels */
        .search-panel, .results-panel{
            background:var(--panel-bg);
            padding:1rem;
            border-radius:8px;
            box-shadow:var(--card-shadow);
        }

        /* Form */
        .text-input{
            width:100%;
            padding:.6rem .75rem;
            font-size:1rem;
            border:1px solid #ddd;
            border-radius:6px;
            margin-bottom:.5rem;
        }
        .form-actions{
            display:flex;
            gap:.5rem;
        }
        .btn{
            padding:.5rem .75rem;
            border:1px solid transparent;
            background:#eee;
            border-radius:6px;
            cursor:pointer;
        }
        .btn-primary{
            background:#0d6efd;
            color:white;
        }
        .btn-secondary{
            background:#6c757d;
            color:white;
        }

        /* Result card */
        .results-container{
            display:flex;
            flex-direction:column;
            gap:var(--gap);
        }
        .result-card{
            min-height:160px;
            padding:1rem;
            border-radius:8px;
            background:linear-gradient(180deg,#fff,#fafbff);
            display:flex;
            gap:1rem;
            align-items:flex-start;
            box-shadow:var(--card-shadow);
        }
        .result-image{
            width:160px;
            height:120px;
            object-fit:cover;
            border-radius:8px;
            background:#f2f2f2;
            flex-shrink:0;
        }
        .result-body{
            flex:1;
        }
        .result-title{
            margin:0 0 .25rem 0;
            font-weight:600;
            font-size:1.1rem;
        }
        .result-sub{
            color:var(--muted);
            font-size:.95rem;
            margin:0 0 .5rem 0;
        }
        .result-meta{
            font-size:.9rem;
            color:#333;
        }

        .pagination{
            display:flex;
            align-items:center;
            gap:.5rem;
        }
        .counter{
            color:var(--muted);
            font-weight:600;
        }

        /* Responsive layout: on wider screens show two columns */
        @@media (min-width:900px){
            .species-search-root{
                flex-direction:row;
            }
            .search-panel{
                width:36%;
                max-width:420px;
            }
            .results-panel{
                width:64%;
            }
        }

        /* Utility */
        .visually-hidden{ position:absolute!important; height:1px; width:1px; overflow:hidden; clip:rect(1px,1px,1px,1px); white-space:nowrap;}
        .sr-only{ position:absolute!important; left:-10000px; top:auto; width:1px; height:1px; overflow:hidden; }
    </style>
}

@section Scripts
{
    <script>
        const initialResults = @Html.Raw(initialJson ?? "[]");
        let results = Array.isArray(initialResults) ? initialResults : [];
        let currentIndex = 0;

        const resultCard = document.getElementById('resultCard');
        const resultCounter = document.getElementById('resultCounter');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const searchForm = document.getElementById('searchForm');
        const nameInput = document.getElementById('nameInput');
        const searchStatus = document.getElementById('searchStatus');
        const clearBtn = document.getElementById('clearBtn');

        function setStatus(text, isErr = false) {
            searchStatus.textContent = text || '';
            searchStatus.style.color = isErr ? 'red' : 'inherit';
        }

        function updateControls() {
            const count = results?.length || 0;
            resultCounter.textContent = `${count ? currentIndex + 1 : 0} / ${count}`;
            prevBtn.disabled = currentIndex <= 0 || count === 0;
            nextBtn.disabled = currentIndex >= count - 1 || count === 0;
        }

        // POST the single item JSON to the server to render as a partial.
        // This does NOT trigger the external API again.
        async function renderServerPartialForIndex(index) {
            if (!results || !results.length || index < 0 || index >= results.length) {
                resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
                updateControls();
                return;
            }

            try {
                const url = new URL('@Url.Action("RenderPartial", "Species")', window.location.origin);
                const resp = await fetch(url.toString(), {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'text/html'
                    },
                    body: JSON.stringify(results[index])
                });

                if (resp.ok) {
                    const html = await resp.text();
                    resultCard.innerHTML = html;
                    currentIndex = index;
                    updateControls();
                } else {
                    const txt = await resp.text();
                    setStatus('Failed to render result: ' + (txt || resp.statusText), true);
                }
            } catch (err) {
                console.error(err);
                setStatus('Failed to render result.', true);
            }
        }

        // Keeps the single API call per search: this fetch gets the full results list.
        async function doSearch(name) {
            setStatus('');
            if (!name || name.trim().length === 0) {
                setStatus('Please enter a name to search.');
                return;
            }

            setStatus('Searching…');
            try {
                const url = new URL(searchForm.action, window.location.origin);
                url.searchParams.set('name', name);

                const resp = await fetch(url.toString(), {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'RequestVerificationToken': searchForm.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                if (!resp.ok) {
                    if (resp.status === 404) {
                        results = [];
                        resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
                        updateControls();
                        setStatus('');
                        return;
                    }
                    const txt = await resp.text();
                    throw new Error(txt || resp.statusText);
                }

                const data = await resp.json();
                results = Array.isArray(data) ? data : [];
                currentIndex = 0;
                updateControls();

                if (results.length > 0) {
                    await renderServerPartialForIndex(0); // server renders selected item without calling API
                    setStatus('');
                } else {
                    resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
                    setStatus('');
                }
            } catch (err) {
                console.error(err);
                setStatus('Search failed. ' + (err?.message ?? ''), true);
                results = [];
                resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
                updateControls();
            }
        }

        // Events
        searchForm.addEventListener('submit', function (e) {
            e.preventDefault();
            const q = nameInput.value;
            doSearch(q);
        });

        prevBtn.addEventListener('click', function () {
            if (currentIndex > 0) {
                renderServerPartialForIndex(currentIndex - 1);
            }
        });

        nextBtn.addEventListener('click', function () {
            if (currentIndex < (results.length - 1)) {
                renderServerPartialForIndex(currentIndex + 1);
            }
        });

        clearBtn.addEventListener('click', function () {
            nameInput.value = '';
            results = [];
            currentIndex = 0;
            resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
            updateControls();
            setStatus('');
        });

        document.addEventListener('DOMContentLoaded', function () {
            if (results && results.length) {
                currentIndex = 0;
                updateControls();
            } else {
                resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
                updateControls();
            }
        });
    </script>
}