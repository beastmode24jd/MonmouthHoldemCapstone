@model List<MH.Capstone.Domain.ApiContracts.Ninja.AnimalApiDto>
@using MH.Capstone.Domain.ApiContracts.Ninja
@using Newtonsoft.Json
@inject MH.Capstone.Domain.Tools.FeatureFlags FeatureFlags
@{
    ViewData["Title"] = "Species Search";
    var initialJson = JsonConvert.SerializeObject(Model ?? new List<AnimalApiDto>());
}
<div class="species-search-root container">
    <section class="search-panel" aria-labelledby="searchHeading">
        <h2 id="searchHeading">Species Search</h2>

        <form id="searchForm" method="get" asp-action="SearchByName" asp-controller="Species" role="search" autocomplete="off">
            @Html.AntiForgeryToken()
            <label for="nameInput" class="visually-hidden">Animal name</label>
            <input id="nameInput" name="name" type="search" class="form-control text-input" placeholder="Search by name…" />
            <div class="form-actions mt-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Search</button>
                <button type="button" id="clearBtn" class="btn btn-secondary">Clear</button>
                @* Feature-flagged button: only render when flag enabled. Visibility toggled client-side based on whether a search returned results *@
                @if (FeatureFlags.IsEnabled("ExposeDetailedApiCacheOnUi"))
                {
                    <button type="button" id="seeCacheBtn" class="btn btn-secondary d-none">See Result Cache</button>
                }
            </div>
        </form>

        <div id="searchStatus" class="status mt-2" aria-live="polite"></div>
    </section>

    <section class="results-panel mt-3" aria-labelledby="resultsHeading">
        <h2 id="resultsHeading" class="sr-only">Search results</h2>

        <div id="resultsContainer" class="results-container">
            <div id="resultCard" class="result-card" aria-live="polite">
                @if (Model != null && Model.Any())
                {
                    <partial name="_AnimalResult" model="Model.First()"/>
                }
                else
                {
                    <div class="result-body"><p class="result-sub">No results.</p></div>
                }
            </div>

            <div class="pagination mt-3 d-flex align-items-center" aria-label="Result navigation">
                <button id="prevBtn" class="btn btn-light me-2" disabled aria-label="Previous result">Previous</button>
                <span id="resultCounter" class="counter me-2" aria-atomic="true">0 / 0</span>
                <button id="nextBtn" class="btn btn-light" disabled aria-label="Next result">Next</button>
            </div>
        </div>
    </section>
</div>

@* Bootstrap modal markup for showing cache details *@
<div class="modal fade" id="cacheModal" tabindex="-1" aria-labelledby="cacheModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="cacheModalLabel">Cache details</h5>
        <button type="button" class="btn-close" id="cacheCloseBtn" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="cacheContent">Loading…</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="cacheCloseBtnFooter">Close</button>
      </div>
    </div>
  </div>
</div>

@section Styles
{
    <style>
        :root{
            --gap: 1rem;
            --muted: #6c757d;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        }

        /* Restore original responsive two-column layout: search on left, results on right */
        .species-search-root{ 
            display:flex;
            flex-direction:column;
            gap:var(--gap);
            padding:1rem;
        }

        .search-panel, .results-panel{
            background:#fff;
            padding:1rem;
            border-radius:8px;
            box-shadow:0 2px 8px rgba(0,0,0,.06);
        }

        /* Keep Bootstrap form control appearance but ensure full width input */
        .text-input{ width:100%; }

        .result-card{ min-height:160px; padding:1rem; border-radius:8px; background:linear-gradient(180deg,#fff,#fafbff); box-shadow:0 2px 8px rgba(0,0,0,.06); }
        .result-body{ flex:1; }
        .result-title{ margin:0 0 .25rem 0; font-weight:600; font-size:1.1rem; }
        .result-sub{ color:var(--muted); font-size:.95rem; margin:0 0 .5rem 0; }
        .counter{ color:var(--muted); font-weight:600; }

        /* At wider screens, show two columns with left search panel and right results */
        @@media (min-width:900px){
            .species-search-root{ flex-direction:row; }
            .search-panel{ width:36%; max-width:420px; }
            .results-panel{ width:64%; }
        }

        /* JSON syntax highlight styles */
        pre.json { white-space: pre-wrap; word-break: break-word; }
        .json-key { color:#922; font-weight:600; }
        .json-string { color:#0b8a0b; }
        .json-number { color:#1c00cf; }
        .json-boolean { color:#aa0b7e; }
        .json-null { color:#777; font-style:italic; }

        /* Utility */
        .visually-hidden{ position:absolute!important; height:1px; width:1px; overflow:hidden; clip:rect(1px,1px,1px,1px); white-space:nowrap;}
        .sr-only{ position:absolute!important; left:-10000px; top:auto; width:1px; height:1px; overflow:hidden; }
    </style>
}

@section Scripts
{
    <script>
        const initialResults = @Html.Raw(initialJson ?? "[]");
        let results = Array.isArray(initialResults) ? initialResults : [];
        let currentIndex = 0;

        const resultCard = document.getElementById('resultCard');
        const resultCounter = document.getElementById('resultCounter');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const searchForm = document.getElementById('searchForm');
        const nameInput = document.getElementById('nameInput');
        const searchStatus = document.getElementById('searchStatus');
        const clearBtn = document.getElementById('clearBtn');
        const seeCacheBtn = document.getElementById('seeCacheBtn');
        const cacheModalEl = document.getElementById('cacheModal');
        const cacheContent = document.getElementById('cacheContent');
        const cacheCloseBtn = document.getElementById('cacheCloseBtn');
        const cacheCloseBtnFooter = document.getElementById('cacheCloseBtnFooter');

        // If Bootstrap JS is available, use its Modal helper
        let bootstrapModal = null;
        try {
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                bootstrapModal = new bootstrap.Modal(cacheModalEl);
            }
        } catch (e) { /* ignore */ }

        function setStatus(text, isErr = false) {
            searchStatus.textContent = text || '';
            searchStatus.style.color = isErr ? 'red' : 'inherit';
        }

        function syntaxHighlightJson(json) {
            if (!json) return '';
            json = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            return json.replace(/("(\\u[a-fA-F0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d+)?(?:[eE][+\-]?\d+)?)/g, function (match) {
                var cls = 'json-number';
                if (/^\"/.test(match)) {
                    if (/:$/.test(match)) cls = 'json-key'; else cls = 'json-string';
                } else if (/true|false/.test(match)) cls = 'json-boolean';
                else if (/null/.test(match)) cls = 'json-null';
                return '<span class="' + cls + '">' + match + '</span>';
            });
        }

        function highlightJsonElements(root) {
            root = root || document;
            const pres = (root.querySelectorAll) ? root.querySelectorAll('pre.json') : [];
            pres.forEach(function (p) {
                // Use textContent to get raw JSON, then replace innerHTML with highlighted content
                try {
                    const raw = p.textContent;
                    p.innerHTML = syntaxHighlightJson(raw);
                } catch (e) {
                    // ignore if something goes wrong
                }
            });
        }

        function updateControls() {
            const count = results?.length || 0;
            resultCounter.textContent = `${count ? currentIndex + 1 : 0} / ${count}`;
            prevBtn.disabled = currentIndex <= 0 || count === 0;
            nextBtn.disabled = currentIndex >= count - 1 || count === 0;

            // If seeCacheBtn exists (feature enabled server-side), toggle visibility based on whether we have results
            if (seeCacheBtn) {
                if (count > 0) seeCacheBtn.classList.remove('d-none'); else seeCacheBtn.classList.add('d-none');
            }
        }

        async function renderServerPartialForIndex(index) {
            if (!results || !results.length || index < 0 || index >= results.length) {
                resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
                updateControls();
                return;
            }

            try {
                const url = new URL('@Url.Action("RenderPartial", "Species")', window.location.origin);
                const resp = await fetch(url.toString(), {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'text/html'
                    },
                    body: JSON.stringify(results[index])
                });

                if (resp.ok) {
                    const html = await resp.text();
                    resultCard.innerHTML = html;
                    currentIndex = index;
                    updateControls();
                } else {
                    const txt = await resp.text();
                    setStatus('Failed to render result: ' + (txt || resp.statusText), true);
                }
            } catch (err) {
                console.error(err);
                setStatus('Failed to render result.', true);
            }
        }

        async function doSearch(name) {
            setStatus('');
            if (!name || name.trim().length === 0) {
                setStatus('Please enter a name to search.');
                return;
            }

            setStatus('Searching…');
            try {
                const url = new URL(searchForm.action, window.location.origin);
                url.searchParams.set('name', name);

                const resp = await fetch(url.toString(), {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'RequestVerificationToken': searchForm.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                if (!resp.ok) {
                    if (resp.status === 404) {
                        results = [];
                        resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
                        updateControls();
                        setStatus('');
                        return;
                    }
                    const txt = await resp.text();
                    throw new Error(txt || resp.statusText);
                }

                const data = await resp.json();
                results = Array.isArray(data) ? data : [];
                currentIndex = 0;
                updateControls();

                if (results.length > 0) {
                    await renderServerPartialForIndex(0);
                    setStatus('');
                } else {
                    resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
                    setStatus('');
                }
            } catch (err) {
                console.error(err);
                setStatus('Search failed. ' + (err?.message ?? ''), true);
                results = [];
                resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
                updateControls();
            }
        }

        async function showCacheForCurrentQuery() {
            const q = nameInput.value;
            if (!q || q.trim().length === 0) return;

            try {
                const url = new URL('@Url.Action("CacheByName", "Species")', window.location.origin);
                url.searchParams.set('name', q);

                const resp = await fetch(url.toString(), {
                    method: 'GET',
                    headers: { 'Accept': 'text/html' }
                });

                if (resp.ok) {
                    const html = await resp.text();
                    cacheContent.innerHTML = html;
                    highlightJsonElements(cacheContent);
                    // If the server did not receive a UserTimeZone cookie, the partial will mark that.
                    try {
                        const cacheRoot = cacheContent.querySelector('.cache-detail-list');
                        const tz = cacheRoot?.dataset?.userTimezone || '';
                        if (!tz) console.log('Info: UserTimeZone cookie not present; CachedAt shown in UTC.');
                    } catch (e) { /* ignore */ }
                    if (bootstrapModal) bootstrapModal.show(); else { cacheModalEl.classList.add('show'); cacheModalEl.style.display = 'block'; }
                } else if (resp.status === 404) {
                    cacheContent.innerHTML = '<div class="text-muted">No cached results found for this query.</div>';
                    if (bootstrapModal) bootstrapModal.show(); else { cacheModalEl.classList.add('show'); cacheModalEl.style.display = 'block'; }
                } else {
                    const txt = await resp.text();
                    cacheContent.innerHTML = '<div class="text-danger">Failed to load cache: ' + (txt || resp.statusText) + '</div>';
                    if (bootstrapModal) bootstrapModal.show(); else { cacheModalEl.classList.add('show'); cacheModalEl.style.display = 'block'; }
                }
            } catch (err) {
                console.error(err);
                cacheContent.innerHTML = '<div class="text-danger">Failed to load cache.</div>';
                if (bootstrapModal) bootstrapModal.show(); else { cacheModalEl.classList.add('show'); cacheModalEl.style.display = 'block'; }
            }
        }

        searchForm.addEventListener('submit', function (e) {
            e.preventDefault();
            const q = nameInput.value;
            doSearch(q);
        });

        prevBtn.addEventListener('click', function () {
            if (currentIndex > 0) {
                renderServerPartialForIndex(currentIndex - 1);
            }
        });

        nextBtn.addEventListener('click', function () {
            if (currentIndex < (results.length - 1)) {
                renderServerPartialForIndex(currentIndex + 1);
            }
        });

        clearBtn.addEventListener('click', function () {
            nameInput.value = '';
            results = [];
            currentIndex = 0;
            resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
            updateControls();
            setStatus('');

            // Hide cache modal and content when clearing
            if (bootstrapModal) bootstrapModal.hide(); else { cacheModalEl.classList.remove('show'); cacheModalEl.style.display = 'none'; }
            cacheContent.innerHTML = '';
        });

        if (seeCacheBtn) {
            seeCacheBtn.addEventListener('click', function () {
                showCacheForCurrentQuery();
            });
        }

        if (cacheCloseBtn) {
            cacheCloseBtn.addEventListener('click', function () {
                if (bootstrapModal) bootstrapModal.hide(); else { cacheModalEl.classList.remove('show'); cacheModalEl.style.display = 'none'; }
            });
        }
        if (cacheCloseBtnFooter) {
            cacheCloseBtnFooter.addEventListener('click', function () {
                if (bootstrapModal) bootstrapModal.hide(); else { cacheModalEl.classList.remove('show'); cacheModalEl.style.display = 'none'; }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (results && results.length) {
                currentIndex = 0;
                updateControls();
            } else {
                resultCard.innerHTML = '<div class="result-body"><p class="result-sub">No results.</p></div>';
                updateControls();
            }

            // Highlight any JSON already on the page (if partial rendered server-side)
            highlightJsonElements(document);
            // If server-rendered cache partial exists and no timezone cookie was present, log for debugging
            try {
                const cacheRootDoc = document.querySelector('.cache-detail-list');
                const tzDoc = cacheRootDoc?.dataset?.userTimezone || '';
                if (cacheRootDoc && !tzDoc) console.log('Info: UserTimeZone cookie not present; CachedAt shown in UTC.');
            } catch (e) { /* ignore */ }
        });
    </script>
}